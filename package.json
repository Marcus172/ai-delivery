{
  "name": "ai-delivery-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pdf": "tsx scripts/generate-pdf.ts",
    "nda": "tsx scripts/nda-gate.ts",
    "test:unit": "vitest run",
    "test:postbuild": "vitest run --config vitest.postbuild.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run pdf && npm run nda && npm run test:unit && npm run test:postbuild && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "unpdf": "^2.1.0",
    "vitest": "^5.1.0"
  }
}
