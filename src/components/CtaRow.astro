---
import type { Locale } from "../i18n/locales";
import { localizedPath } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pdf = `${localizedPath(locale, "cv")}marek-rom-cv-${locale}.pdf`;
---

<div class="cta">
  <a class="btn" href={pdf} download>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3v12M7 10l5 5 5-5M4 19h16"></path>
    </svg>
    {t(locale, "cta.cv")}
  </a>
  <a class="btn ghost" href="mailto:marek.marcus.rom@gmail.com">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="M3 7l9 6 9-6"></path>
    </svg>
    {t(locale, "cta.email")}
  </a>
  <a class="btn ghost" href="https://www.linkedin.com/in/marek-rom-a91445b8" rel="noopener" target="_blank">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 10v7M7 7v.01M11 17v-4a2.5 2.5 0 0 1 5 0v4M11 10v7"></path>
      <rect x="3" y="3" width="18" height="18" rx="3"></rect>
    </svg>
    {t(locale, "cta.linkedin")}
  </a>
</div>

<style>
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
