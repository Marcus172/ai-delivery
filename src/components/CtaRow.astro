---
import type { Locale } from "../i18n/locales";
import { cvPdfPath } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pdf = cvPdfPath(locale);
---

<div class="cta">
  <a class="btn" href="mailto:marek.marcus.rom@gmail.com">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="M3 7l9 6 9-6"></path>
    </svg>
    {t(locale, "cta.email")}
  </a>
  <a class="btn ghost" href={pdf} download>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3v12M7 10l5 5 5-5M4 19h16"></path>
    </svg>
    {t(locale, "cta.cv")}
  </a>
  <span class="icons">
  <a class="btn ghost icon" href="https://www.linkedin.com/in/marek-rom-a91445b8" aria-label={t(locale, "cta.linkedin")} rel="noopener" target="_blank">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 10v7M7 7v.01M11 17v-4a2.5 2.5 0 0 1 5 0v4M11 10v7"></path>
      <rect x="3" y="3" width="18" height="18" rx="3"></rect>
    </svg>
  </a>
  <a class="btn ghost icon" href="https://github.com/Marcus172" aria-label={t(locale, "cta.github")} rel="noopener" target="_blank">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.3c3-.3 6-1.5 6-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.7 12.7 0 0 0-6.6 0C5.7 1.1 4.6 1.4 4.6 1.4a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 3 8.6c0 5.1 3 6.3 6 6.6a3 3 0 0 0-.9 2.3V21"></path>
    </svg>
  </a>
  </span>
</div>

<style>
  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  /* The icon links sit in the row on wide screens and get a row of their own on phones. */
  .icons {
    display: contents;
  }
  @media (max-width: 559px) {
    .icons {
      display: flex;
      flex-basis: 100%;
      gap: 0.75rem;
    }
  }
  .cta :global(.btn.icon) {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    justify-content: center;
  }
  .cta :global(.btn.icon svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
