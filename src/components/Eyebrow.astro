---
interface Props {
  as?: "p" | "span" | "div" | "h2";
}

const { as: Tag = "p" } = Astro.props;
---

<Tag class="eyebrow"><slot /></Tag>

<style>
  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variation-settings: "wdth" 100;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.55;
    color: var(--mute);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 0.875rem;
  }
  .eyebrow::before {
    content: "";
    width: 1.75rem;
    height: 2px;
    background: var(--ink);
    flex: none;
  }
</style>
