---
interface Props {
  as?: "p" | "span" | "div" | "h2";
}

const { as: Tag = "p" } = Astro.props;
---

<Tag class="eyebrow"><slot /></Tag>

<style>
  .eyebrow {
    font-size: 1rem;
    font-weight: 700;
    font-variation-settings: "wdth" 100;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }
  .eyebrow::before {
    content: "";
    width: 2rem;
    height: 2px;
    background: var(--ink);
    flex: none;
  }
</style>
