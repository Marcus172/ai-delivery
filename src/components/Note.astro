---
interface Props {
  as?: "aside" | "p" | "div";
}

const { as: Tag = "aside" } = Astro.props;
---

<Tag class="note"><slot /></Tag>

<style>
  .note {
    margin-top: 1rem;
    border-left: 0.1875rem solid var(--acc);
    padding: 0.375rem 0 0.375rem 0.875rem;
    color: var(--mute);
  }
  .note :global(strong) {
    color: var(--ink);
  }
</style>
