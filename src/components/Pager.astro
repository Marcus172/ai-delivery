---
/** The two cards at the end of a Wins sub-page: where to go back to, and where to go next. */
export interface PagerLink {
  href: string;
  /** Small accent label above the title, e.g. "Previous case". */
  k: string;
  /** The destination's title. */
  v: string;
  rel?: "prev" | "next";
}

interface Props {
  label: string;
  prev?: PagerLink;
  next?: PagerLink;
}

const { label, prev, next } = Astro.props;
---

<nav class="pager" aria-label={label} data-pager>
  {
    prev ? (
      <a class="prev" href={prev.href} rel={prev.rel}>
        <span class="k">{prev.k}</span>
        <span class="v">{prev.v}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a class="next" href={next.href} rel={next.rel}>
        <span class="k">{next.k}</span>
        <span class="v">{next.v}</span>
      </a>
    )
  }
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 2.5rem 1rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.375rem;
    padding: 1.25rem 1.375rem;
    background: var(--tint);
    border-radius: 0.875rem;
    text-decoration: none;
  }
  .pager a:hover {
    outline: 2px solid var(--acc);
    outline-offset: -2px;
  }
  .pager .next {
    text-align: right;
  }
  .pager .k {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
  }
  .pager .v {
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
    font-size: 1.375rem;
    line-height: 1.05;
  }
  @media (max-width: 699px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
