---
/**
 * Long-form body for MDX content (AI Delivery chapters, Results, case pages): lists, stats, examples, caveats.
 * Every block runs to the column edge; the page decides the column width, so text and diagrams share both edges.
 * Text rules target the body's own children only (`>`), so they never leak into the markup of a diagram.
 */
import { linkToolsInHtml } from "../lib/link-tools-html";

interface Props {
  /** Link the first mention of each external tool (off for a nested body that the outer one covers). */
  toolLinks?: boolean;
}

const { toolLinks = true } = Astro.props;
const html = await Astro.slots.render("default");
---

<div class="body" set:html={toolLinks ? linkToolsInHtml(html) : html} />

<style>
  .body {
    margin-top: 1.75rem;
  }
  /* On a case page the body's sections are h2 (the page has no chapter level); they read like h3 in a chapter. */
  .body > :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    font-variation-settings: normal;
    text-transform: none;
    letter-spacing: -0.01em;
    line-height: inherit;
    margin-top: 2.5rem;
  }
  .body > :global(h2 + p) {
    margin-top: 0.625rem;
  }
  .body > :global(p + p),
  .body > :global(ul + p),
  .body > :global(p + ul) {
    margin-top: 1rem;
  }
  .body > :global(h3) {
    margin-top: 2.5rem;
  }
  .body > :global(h3 + p) {
    margin-top: 0.625rem;
  }
  .body > :global(ul),
  .body > :global(ol) {
    padding-left: 1.375rem;
  }
  .body > :global(:is(ul, ol) > li + li) {
    margin-top: 0.375rem;
  }
  .body :global(strong) {
    font-weight: 700;
  }
  .body :global(.stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    gap: 1.5rem 1.75rem;
    margin-top: 2rem;
  }
  .body :global(.stats + p),
  .body :global(.band + p),
  .body :global(.scroll + p),
  .body :global(.note + p),
  .body :global(.media + p),
  .body :global(.stat + p),
  .body :global([data-diagram] + p),
  .body :global(.glance + p) {
    margin-top: 2rem;
  }
  .body :global(.stat) {
    margin-top: 1.75rem;
  }
  .body :global(.stats .stat) {
    margin-top: 0;
  }
  .body :global(.example) {
    margin-top: 1.75rem;
    padding: 1.375rem 1.5rem;
    background: var(--tint);
    border-radius: 0.875rem;
  }
  .body :global(.example p + p) {
    margin-top: 0.625rem;
  }
  .body :global(.example .k) {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
    margin-bottom: 0.5rem;
  }

  .body :global(.caveats) {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .body :global(.caveats + h3) {
    margin-top: 3rem;
  }
  .body :global(.estimate) {
    margin-top: 1rem;
    padding: 1.125rem 1.375rem;
    border: 1px dashed var(--line);
    border-radius: 0.875rem;
    color: var(--mute);
  }
  .body :global(.estimate .stat) {
    margin-top: 0;
  }
  .body :global(.estimate p) {
    margin-top: 1rem;
  }
  .body :global(.estimate a) {
    color: var(--ink);
  }
</style>
