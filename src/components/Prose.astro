---
/** Long-form body for MDX content (AI Delivery chapters, Results, case pages): text measure, lists, stats, examples, caveats. */
---

<div class="body"><slot /></div>

<style>
  .body {
    margin-top: 1.75rem;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol),
  .body :global(h2),
  .body :global(h3) {
    max-width: 68ch;
  }
  /* On a case page the body's sections are h2 (the page has no chapter level); they read like h3 in a chapter. */
  .body :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    font-variation-settings: normal;
    text-transform: none;
    letter-spacing: -0.01em;
    line-height: inherit;
    margin-top: 2.5rem;
  }
  .body :global(h2 + p) {
    margin-top: 0.625rem;
  }
  .body :global(p + p),
  .body :global(ul + p),
  .body :global(p + ul) {
    margin-top: 1rem;
  }
  .body :global(h3) {
    margin-top: 2.5rem;
  }
  .body :global(h3 + p) {
    margin-top: 0.625rem;
  }
  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.375rem;
  }
  .body :global(li + li) {
    margin-top: 0.375rem;
  }
  .body :global(strong) {
    font-weight: 700;
  }
  .body :global(.stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    gap: 1.5rem 1.75rem;
    margin-top: 2rem;
    max-width: 47.5rem;
  }
  .body :global(.stats + p),
  .body :global(.band + p),
  .body :global(.scroll + p),
  .body :global(.note + p),
  .body :global(.stat + p) {
    margin-top: 2rem;
  }
  .body :global(.stat) {
    margin-top: 1.75rem;
  }
  .body :global(.stats .stat) {
    margin-top: 0;
  }
  .body :global(.example) {
    margin-top: 1.75rem;
    padding: 1.375rem 1.5rem;
    background: var(--tint);
    border-radius: 0.875rem;
    max-width: 68ch;
  }
  .body :global(.example p + p) {
    margin-top: 0.625rem;
  }
  .body :global(.example .k) {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
    margin-bottom: 0.5rem;
  }

  .body :global(.caveats) {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16.25rem, 1fr));
    gap: 1.25rem 1.75rem;
    max-width: 53.75rem;
  }
  .body :global(.caveats li) {
    margin: 0;
    padding: 1rem 1.125rem;
    background: var(--tint);
    border-radius: 0.75rem;
    font-size: 0.875rem;
    color: var(--mute);
    line-height: 1.5;
  }
  .body :global(.caveats li strong) {
    color: var(--ink);
  }
  .body :global(.caveats .stat) {
    margin-top: 0;
  }
  .body :global(.caveats + h3) {
    margin-top: 3rem;
  }
  .body :global(.estimate) {
    margin-top: 1rem;
    padding: 1.125rem 1.375rem;
    border: 1px dashed var(--line);
    border-radius: 0.875rem;
    max-width: 68ch;
    color: var(--mute);
  }
  .body :global(.estimate a) {
    color: var(--ink);
  }
</style>
