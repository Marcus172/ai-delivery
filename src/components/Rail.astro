---
import type { Locale } from "../i18n/locales";
import { localizedPath, PAGE_IDS, type PageId } from "../i18n/routes";
import { t, type UiKey } from "../i18n/ui";
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;

/* Inline 24-grid line icons, 1.8 stroke, no library. */
const ICONS: Record<PageId, string> = {
  landing: '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  journey: '<path d="M5 19c0-4 3-5 7-7s7-3 7-7"/><circle cx="5" cy="19" r="2.2"/><circle cx="19" cy="5" r="2.2"/>',
  "ai-delivery":
    '<circle cx="12" cy="12" r="2.6"/><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="3.5" r="1.6" fill="currentColor" stroke="none"/><circle cx="18.6" cy="17" r="1.6" fill="currentColor" stroke="none"/>',
  cv: '<path d="M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5M9 12h6M9 16h6"/>',
};
---

<nav class="rail" aria-label={t(locale, "nav.label")}>
  <a class="mark" href={localizedPath(locale, "landing")}>MR<span class="sr"> – {t(locale, "site.name")}</span></a>
  {
    PAGE_IDS.map((id) => {
      const label = t(locale, `nav.${id}` as UiKey);
      const current = id === page;

      return (
        <a href={localizedPath(locale, id)} aria-current={current ? "page" : undefined} aria-label={label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[id]} />
          <span class="tip" aria-hidden="true">{label}</span>
        </a>
      );
    })
  }
  <div class="spacer"></div>
  <LangSwitch locale={locale} page={page} />
  <ThemeToggle locale={locale} />
</nav>

<style>
  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 1.125rem;
    gap: 0.375rem;
    background: var(--bg);
  }
  .mark {
    font-weight: 800;
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.875rem;
    text-decoration: none;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
  }
  a:not(.mark) {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 0.625rem;
    color: var(--mute);
    text-decoration: none;
    position: relative;
  }
  a:not(.mark):hover,
  a:not(.mark):focus-visible {
    color: var(--ink);
    background: var(--tint);
  }
  a[aria-current="page"] {
    color: var(--ink);
  }
  a[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: -0.75rem;
    top: 0.625rem;
    bottom: 0.625rem;
    width: 0.1875rem;
    border-radius: 0.1875rem;
    background: var(--acc);
  }
  a svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .tip {
    position: absolute;
    left: 3rem;
    top: 50%;
    translate: 0 -50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
    z-index: 10;
  }
  a:hover .tip,
  a:focus-visible .tip {
    opacity: 1;
  }
  .spacer {
    flex: 1;
  }
  @media (max-width: 899px) {
    .rail {
      height: auto;
      flex-direction: row;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 0.5rem 0.75rem;
      z-index: 5;
      overflow-x: auto;
      gap: 2px;
    }
    .mark {
      margin: 0 0.375rem 0 0;
    }
    .tip {
      display: none;
    }
    a[aria-current="page"]::before {
      left: 0.75rem;
      right: 0.75rem;
      top: auto;
      bottom: 0.25rem;
      width: auto;
      height: 2px;
    }
  }
  @media print {
    .rail {
      display: none;
    }
  }
</style>
