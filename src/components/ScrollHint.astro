---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<p class="hscroll-hint"><span aria-hidden="true">→</span> {t(locale, "diagram.scrollHint")}</p>

<script>
  // Marks each sideways-scrolling region that actually overflows, so its hint shows.
  const mark = () =>
    document.querySelectorAll<HTMLElement>(".hscroll").forEach((el) => {
      const hint = el.nextElementSibling;
      if (hint?.classList.contains("hscroll-hint")) hint.toggleAttribute("data-overflow", el.scrollWidth > el.clientWidth);
    });
  mark();
  addEventListener("resize", mark);
</script>
