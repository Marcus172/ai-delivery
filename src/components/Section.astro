---
interface Props {
  id?: string;
  /** Visually quieter top edge: no rule above the section (for the first one on a page). */
  first?: boolean;
  class?: string;
}

const { id, first = false, class: className } = Astro.props;
---

<section id={id} class:list={["section", { first }, className]}>
  <slot />
</section>

<style>
  .section {
    padding-block: 4.5rem;
    border-top: 1px solid var(--line);
  }
  .section.first {
    border-top: 0;
    padding-top: 0;
  }
  @media (max-width: 899px) {
    .section {
      padding-block: 3rem;
    }
  }
</style>
