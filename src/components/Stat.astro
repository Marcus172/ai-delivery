---
import { metric } from "../data/metrics";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Resolve value, label, kind, period and caveat from `metric(id)`; chapters use this form. */
  id?: string;
  value?: string;
  label?: string;
  kind?: "measured" | "estimate";
  /** With `id`: also print the period line and the caveat (default on). */
  detail?: boolean;
}

const { locale, id, detail = true } = Astro.props;
const m = id ? metric(id) : undefined;
const value = m ? m.value[locale] : (Astro.props.value ?? "");
const label = m ? m.label[locale] : (Astro.props.label ?? "");
const kind = m ? m.kind : Astro.props.kind;
const period = m && detail ? m.period[locale] : undefined;
const caveat = m && detail ? m.caveat?.[locale] : undefined;
---

<div class="stat" data-kind={kind} data-metric={id}>
  <b>{value}</b>
  <span>{label}</span>
  {kind && <small>{t(locale, kind === "measured" ? "badge.measured" : "badge.estimate")}</small>}
  {period && <em class="period">{period}</em>}
  {caveat && <p class="caveat">{caveat}</p>}
</div>

<style>
  .stat {
    border-left: 2px solid var(--line);
    padding-left: 0.875rem;
  }
  .stat[data-kind="measured"] {
    border-left-color: var(--acc);
  }
  b {
    display: block;
    font-variation-settings: "wdth" 80;
    font-size: 2.125rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  span {
    display: block;
    color: var(--mute);
    font-size: 0.8125rem;
    margin-top: 0.375rem;
  }
  small {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--mute);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 0.5rem;
  }
  .stat[data-kind="estimate"] small {
    background: var(--tint);
    border-color: transparent;
  }
  .period {
    display: block;
    font-style: normal;
    font-size: 0.75rem;
    color: var(--mute);
    margin-top: 0.5rem;
  }
  .caveat {
    font-size: 0.8125rem;
    color: var(--mute);
    margin-top: 0.5rem;
    max-width: 48ch;
  }
</style>
