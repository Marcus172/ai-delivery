---
import { metric } from "../../data/metrics";
import type { Locale } from "../../i18n/locales";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
  /** A caveat backed by a metric: the value is the term, label and caveat the text, kind and period the source line. */
  id?: string;
  /** A plain caveat: the term on the left, the slot as the text. */
  term?: string;
  /** Hide the measured/estimate badge, for a metric that states a scope rather than a measurement. */
  badge?: boolean;
}

const { locale, id, term, badge = true } = Astro.props;
const m = id ? metric(id) : undefined;
---

<li class="caveat-item" data-metric={id}>
  <span class="term">{m ? m.value[locale] : term}</span>
  <div class="text">
    {
      m ? (
        <>
          <p>
            <strong>{m.label[locale]}.</strong> {m.caveat?.[locale]}
          </p>
          <p class="source">
            {badge && <small>{t(locale, m.kind === "measured" ? "badge.measured" : "badge.estimate")}</small>}
            <em class="period">{m.period[locale]}</em>
          </p>
        </>
      ) : (
        <p>
          <slot />
        </p>
      )
    }
  </div>
</li>

<style>
  .caveat-item {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.375rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mute);
  }
  .caveat-item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .term {
    font-variation-settings: "wdth" 80;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  strong {
    color: var(--ink);
    font-weight: 600;
  }
  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
  }
  small {
    font-size: 0.6875rem;
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 1px 0.5rem;
  }
  .period {
    font-style: normal;
  }
  @media (max-width: 599px) {
    .caveat-item {
      grid-template-columns: 1fr;
    }
  }
</style>
