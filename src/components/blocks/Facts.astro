---
/** A spec sheet: short label → one line, instead of a paragraph that lists properties. Holds `<Fact>` children. */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<dl class="facts" aria-label={label}>
  <slot />
</dl>

<style>
  .facts {
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: minmax(8rem, max-content) minmax(0, 1fr);
    border-top: 1px solid var(--line);
    max-width: 47.5rem;
  }
  @media (max-width: 559px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
