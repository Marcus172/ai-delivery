---
import { l } from "../../data/l10n";
import type { Locale } from "../../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const LABEL = l("One ticket through the flow: who decides, who prepares", "Jeden tiket ve flow: kdo rozhoduje, kdo připravuje");
const HUMAN = l("a person decides", "rozhoduje člověk");
const AGENT = l("an agent prepares", "připravuje agent");

type Phase = { name: string; human: string; agent: string };
const PHASES: Record<Locale, Phase[]> = {
  en: [
    { name: "Analysis", human: "asks the questions the brief leaves open", agent: "reads the ticket, the analysis and the attachments" },
    { name: "Spec", human: "picks a variant in the visual plan", agent: "drafts the variants" },
    { name: "Code", human: "watches the red test fail first", agent: "implements in its own workspace" },
    { name: "Review", human: "triggers submission", agent: "runs the local replica of the CI gate" },
    { name: "Handover", human: "sends and approves what the client sees", agent: "drafts the notes for testers" },
  ],
  cs: [
    { name: "Analýza", human: "klade otázky, které zadání nechává otevřené", agent: "čte tiket, analýzu a přílohy" },
    { name: "Spec", human: "vybere variantu ve vizuálním plánu", agent: "navrhne varianty" },
    { name: "Kód", human: "vidí nejdřív padnout červený test", agent: "implementuje ve vlastním pracovišti" },
    { name: "Review", human: "spouští odevzdání", agent: "pustí lokální repliku CI brány" },
    { name: "Předání", human: "posílá a schvaluje, co uvidí klient", agent: "navrhne poznámky pro testery" },
  ],
};
---

<figure class="band" data-diagram="flow-band">
  <figcaption class="sr">{LABEL[locale]}</figcaption>
  <ol class="steps">
    {
      PHASES[locale].map((p) => (
        <li class="step">
          <h3>{p.name}</h3>
          <p class="h">
            <i aria-hidden="true" />
            <span class="sr">{HUMAN[locale]}: </span>
            {p.human}
          </p>
          <p class="a">
            <i aria-hidden="true" />
            <span class="sr">{AGENT[locale]}: </span>
            {p.agent}
          </p>
        </li>
      ))
    }
  </ol>
  <p class="legend" aria-hidden="true">
    <span class="h"><i></i>{HUMAN[locale]}</span>
    <span class="a"><i></i>{AGENT[locale]}</span>
  </p>
</figure>

<style>
  .band {
    margin: 32px 0 0;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    counter-reset: step;
  }
  .step {
    padding: 18px 16px 16px;
    border-left: 1px solid var(--line);
    min-width: 0;
  }
  .step:first-child {
    border-left: 0;
  }
  .step h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 10px;
  }
  .step h3::before {
    counter-increment: step;
    content: counter(step) " ";
    color: var(--acc-text);
    font-variant-numeric: tabular-nums;
  }
  .step p {
    font-size: 13px;
    line-height: 1.4;
    display: flex;
    gap: 7px;
    color: var(--mute);
    margin: 0;
  }
  .step p + p {
    margin-top: 8px;
  }
  .step p.h {
    color: var(--ink);
    font-weight: 600;
  }
  .step i,
  .legend i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
    flex: none;
    display: inline-block;
    margin-top: 5px;
  }
  .step .h i,
  .legend .h i {
    background: var(--acc);
  }
  .legend {
    display: flex;
    gap: 20px;
    margin: 12px 0 0;
    font-size: 13px;
    color: var(--mute);
  }
  .legend span {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .legend i {
    margin-top: 0;
  }
  @media (max-width: 899px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .step {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .step:first-child {
      border-top: 0;
    }
  }
</style>
