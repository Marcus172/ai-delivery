---
import { RESULTS_GROUPS } from "../../data/metrics";
import type { Locale } from "../../i18n/locales";
import Stat from "../Stat.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="results-grid" data-diagram="results-grid">
  {
    RESULTS_GROUPS.map((g) => (
      <div class="group" data-group={g.id}>
        <h4>{g.title[locale]}</h4>
        <p class="note">{g.note[locale]}</p>
        <div class="grid">
          {g.metrics.map((id) => (
            <Stat id={id} locale={locale} />
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .results-grid {
    display: grid;
    gap: 2.75rem;
    margin-top: 1.5rem;
    max-width: 53.75rem;
  }
  h4 {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
  }
  .note {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--mute);
    max-width: 64ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.25rem;
    margin-top: 1.25rem;
  }
  .grid :global(.stat) {
    margin-top: 0;
  }
  @media (max-width: 599px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
