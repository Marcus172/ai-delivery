---
import { RESULTS_METRIC_IDS } from "../../data/metrics";
import type { Locale } from "../../i18n/locales";
import Stat from "../Stat.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="stats results-grid" data-diagram="results-grid">
  {RESULTS_METRIC_IDS.map((id) => <Stat id={id} locale={locale} />)}
</div>

<style>
  .results-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.25rem;
    margin-top: 2rem;
    max-width: 53.75rem;
  }
  @media (max-width: 599px) {
    .results-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
