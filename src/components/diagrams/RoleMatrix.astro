---
import { l } from "../../data/l10n";
import type { Locale } from "../../i18n/locales";
import ScrollHint from "../ScrollHint.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const TITLE = l(
  "Which role uses what: the full ticket flow, shared plugins, a plugin for their own role, and skills contributed to the marketplace",
  "Která role používá co: plný flow tiketu, sdílené pluginy, plugin pro vlastní roli a skilly přispěné do marketplace",
);
const DESC = l(
  "Only developers on this codebase run the full ticket flow. Every role installs the shared plugins. Analysts, testers, the project manager and backend developers each have a plugin for their own role, and every role has contributed skills; the tester and the analyst plugins were written by a tester and an analyst.",
  "Plný flow tiketu jedou jen vývojáři na tomto kódu. Sdílené pluginy instaluje každá role. Analytici, testeři, projektový manažer i backendoví vývojáři mají plugin pro vlastní roli a každá role přispěla skilly; testovací a analytický plugin napsali tester a analytik.",
);
const LEGEND = l("filled: yes · hollow: no", "plný: ano · prázdný: ne");

const COLS = [
  { title: l("full ticket flow", "plný flow tiketu"), short: l("flow", "flow") },
  { title: l("shared plugins", "sdílené pluginy"), short: l("shared", "sdílené") },
  { title: l("own role plugin", "plugin pro roli"), short: l("role", "role") },
  { title: l("contributed skills", "přispěné skilly"), short: l("skills", "skilly") },
];
// src: research note 02, §2.1–2.2, §3 (roles and their plugins; 7 contributors from 5 roles)
const ROWS: { role: ReturnType<typeof l>; cells: boolean[] }[] = [
  { role: l("developers on this codebase", "vývojáři na tomto kódu"), cells: [true, true, true, true] },
  { role: l("backend developers", "backendoví vývojáři"), cells: [false, true, true, true] },
  { role: l("analysts", "analytici"), cells: [false, true, true, true] },
  { role: l("testers", "testeři"), cells: [false, true, true, true] },
  { role: l("project manager", "projektový manažer"), cells: [false, true, true, true] },
];

const TOP = 54;

/**
 * One render path, two geometries: an SVG viewBox cannot be re-laid-out by a media query.
 * Wide: 760 px box, scrolls below ~42 rem. Phone: 358 px is the content box of a 390 px screen,
 * so it scales 1:1 and needs no scroll; short column labels, 9rem role column, wrapped role names.
 */
const GEOS = [
  { id: "role-matrix", cls: "matrix", W: 760, left: 232, colGap: 16, rowH: 40, wrapAt: Infinity, short: false, colFs: 12.5 },
  { id: "role-matrix-narrow", cls: "matrix-narrow", W: 358, left: 144, colGap: 8, rowH: 48, wrapAt: 20, short: true, colFs: 12 },
].map((g) => ({
  ...g,
  colW: (g.W - g.left - g.colGap) / COLS.length,
  H: TOP + ROWS.length * g.rowH + 34,
}));

/** Greedy wrap into lines of at most `max` characters. */
function wrap(text: string, max: number): string[] {
  const lines: string[] = [];
  for (const word of text.split(" ")) {
    const last = lines[lines.length - 1];
    if (last !== undefined && (last + " " + word).length <= max) lines[lines.length - 1] = last + " " + word;
    else lines.push(word);
  }
  return lines;
}
---

<div class="scroll hscroll" tabindex="0" role="region" aria-label={TITLE[locale]}>
  {
    GEOS.map((g) => (
      <svg
        class={g.cls}
        data-diagram={g.id}
        viewBox={`0 0 ${g.W} ${g.H}`}
        role="img"
        aria-labelledby={`${g.id}-t`}
        aria-describedby={`${g.id}-d`}
      >
        <title id={`${g.id}-t`}>{TITLE[locale]}</title>
        <desc id={`${g.id}-d`}>{DESC[locale]}</desc>

        {COLS.map((c, j) => (
          <text class="col" x={g.left + j * g.colW + g.colW / 2} y="22" text-anchor="middle" font-size={g.colFs}>
            {(g.short ? c.short : c.title)[locale]}
          </text>
        ))}
        <line class="rule" x1="0" y1={TOP - 16} x2={g.W} y2={TOP - 16} />

        {ROWS.map((r, i) => {
          const y = TOP + i * g.rowH;
          const lines = wrap(r.role[locale], g.wrapAt);

          return (
            <g class="row">
              <text class="role" x="0" y={y + 5 - ((lines.length - 1) * 15) / 2} font-size="13">
                {lines.map((ln, k) => (
                  <tspan x="0" dy={k === 0 ? 0 : 15}>
                    {ln}
                  </tspan>
                ))}
              </text>
              {r.cells.map((on, j) => (
                <circle class:list={["cell", { on }]} cx={g.left + j * g.colW + g.colW / 2} cy={y} r="7" />
              ))}
              <line class="rule soft" x1="0" y1={y + g.rowH / 2} x2={g.W} y2={y + g.rowH / 2} />
            </g>
          );
        })}

        <text class="legend" x="0" y={g.H - 6} font-size="12.5">{LEGEND[locale]}</text>
      </svg>
    ))
  }
</div>
<ScrollHint locale={locale} />

<style>
  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    margin-top: 1.75rem;
  }
  .matrix {
    display: block;
    width: 100%;
    /* 660 / 760 keeps 12.5 px labels ≥ 11 px rendered inside a 358 px phone box. */
    min-width: 42.5rem;
    overflow: visible;
  }
  .matrix-narrow {
    display: none;
    width: 100%;
    max-width: 30rem;
    overflow: visible;
  }
  @media (max-width: 40rem) {
    .matrix {
      display: none;
    }
    .matrix-narrow {
      display: block;
    }
  }
  .col,
  .legend {
    fill: var(--mute);
  }
  .col {
    font-weight: 600;
  }
  .role {
    fill: var(--ink);
    font-weight: 600;
  }
  .rule {
    stroke: var(--ink);
  }
  .rule.soft {
    stroke: var(--line);
  }
  .cell {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .cell.on {
    fill: var(--acc);
    stroke: var(--acc);
  }
</style>
