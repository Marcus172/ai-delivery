---
import type { Milestone } from "../../data/journey";
import { formatMonthOnly } from "../../i18n/dates";
import type { Locale } from "../../i18n/locales";
import { t } from "../../i18n/ui";

interface Props {
  items: Milestone[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const BAND_YEAR = "2026";

const compact = items.filter((m) => m.weight === "compact");
const recent = items.filter((m) => m.weight === "expanded" && !m.date.startsWith(`${BAND_YEAR}-`));
const band = items.filter((m) => m.date.startsWith(`${BAND_YEAR}-`));
const year = (m: Milestone) => m.date.slice(0, 4);
---

<ol class="tl" aria-label={t(locale, "journey.eyebrow")}>
  <li class="era strip" data-era="early">
    <h2 class="era-title" id="era-early">{t(locale, "journey.early")}</h2>
    <p class="era-note">{t(locale, "journey.earlyNote")}</p>
    <ol class="rows" aria-labelledby="era-early">
      {
        compact.map((m) => (
          <li class="row" data-milestone data-weight={m.weight} data-date={m.date}>
            <time datetime={m.date}>{year(m)}</time>
            <span class="row-title">{m.title[locale]}</span>
            <span class="row-body">{m.body[locale]}</span>
          </li>
        ))
      }
    </ol>
  </li>

  <li class="era recent" data-era="recent">
    <h2 class="era-title" id="era-recent">{t(locale, "journey.recent")}</h2>
    <ol class="cards" aria-labelledby="era-recent">
      {
        recent.map((m) => (
          <li class="card" data-milestone data-weight={m.weight} data-date={m.date}>
            <time datetime={m.date}>
              <b>{year(m)}</b>{" "}
              <span>{formatMonthOnly(locale, m.date)}</span>
            </time>
            <div class="card-text">
              <h3>{m.title[locale]}</h3>
              <p>{m.body[locale]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </li>

  <li class="era band" data-era="band" data-band={BAND_YEAR}>
    <div class="band-head">
      <h2 class="era-title band-year" id="era-band">
        <span class="band-num">{BAND_YEAR}</span>
        <span class="band-label">{t(locale, "journey.band")}</span>
      </h2>
      <p class="era-note">{t(locale, "journey.bandNote")}</p>
    </div>
    <ol class="months" aria-labelledby="era-band">
      {
        band.map((m) => (
          <li class="month" data-milestone data-weight={m.weight} data-date={m.date}>
            <time datetime={m.date}>{formatMonthOnly(locale, m.date)}</time>
            <div class="month-text">
              <h3>{m.title[locale]}</h3>
              <p>{m.body[locale]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </li>
</ol>

<style>
  .tl,
  .rows,
  .cards,
  .months {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .era + .era {
    margin-top: 4.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--line);
  }
  .era-title {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    margin-bottom: 0.5rem;
  }
  .era-note {
    color: var(--mute);
    max-width: 60ch;
    margin: 0 0 1.75rem;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  /* ---------- 2014–2023: dense strip ---------- */
  .row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 0 1.5rem;
    align-items: baseline;
    padding: 0.875rem 0;
    border-top: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .row time {
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .row-title {
    font-weight: 700;
    font-size: 1rem;
  }
  .row-body {
    color: var(--mute);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* ---------- 2024–2025: cards ---------- */
  .cards {
    display: grid;
    gap: 1rem;
  }
  .card {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.25rem 2rem;
    padding: 1.625rem 0 1.75rem;
    border-top: 2px solid var(--ink);
  }
  .card time {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .card time b {
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    font-size: 3.5rem;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .card time span {
    color: var(--mute);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .card-text {
    max-width: 66ch;
  }
  .card-text p {
    color: var(--mute);
  }

  /* ---------- 2026: one band, months on a spine ---------- */
  .band {
    position: relative;
  }
  .band-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1.5rem 2.5rem;
    align-items: end;
    margin-bottom: 2.25rem;
  }
  .band-year {
    display: grid;
    gap: 0.625rem;
    margin: 0;
  }
  .band-num {
    display: block;
    font-size: clamp(5rem, 11vw, 9rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: var(--acc);
  }
  .band-label {
    display: block;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
  }
  .band .era-note {
    margin-bottom: 0.375rem;
  }
  .months {
    position: relative;
    padding-left: 10rem;
  }
  .months::before {
    content: "";
    position: absolute;
    left: 8rem;
    top: 0.625rem;
    bottom: 0.625rem;
    width: 2px;
    background: var(--line);
  }
  .month {
    position: relative;
    padding: 1.375rem 0 1.625rem;
  }
  .month + .month {
    border-top: 1px solid var(--line);
  }
  .month::before {
    content: "";
    position: absolute;
    left: -2.3125rem;
    top: 1.875rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--acc);
  }
  .month:last-child::before {
    background: var(--acc);
  }
  .month time {
    position: absolute;
    left: -10rem;
    top: 1.5rem;
    width: 7rem;
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: lowercase;
  }
  .month time::first-letter {
    text-transform: uppercase;
  }
  .month-text {
    max-width: 66ch;
  }
  .month-text p {
    color: var(--mute);
  }

  @media (max-width: 899px) {
    .era + .era {
      margin-top: 3rem;
      padding-top: 2.5rem;
    }
    .row {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 0.25rem 1rem;
    }
    .row time {
      font-size: 1.375rem;
      grid-row: span 2;
      align-self: start;
    }
    .row-body {
      grid-column: 2;
    }
    .card {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.25rem 0 1.5rem;
    }
    .card time {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
    .card time b {
      font-size: 2.5rem;
    }
    .band-head {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .months {
      padding-left: 1.75rem;
    }
    .months::before {
      left: 0.3125rem;
      top: 0.875rem;
    }
    .month {
      padding: 1.25rem 0 1.375rem;
    }
    .month::before {
      left: -1.75rem;
      top: 1.625rem;
    }
    .month time {
      position: static;
      display: block;
      width: auto;
      font-size: 1.25rem;
      color: var(--acc-text);
      margin-bottom: 0.5rem;
    }
  }
</style>
