---
import { l } from "../../data/l10n";
import type { Locale } from "../../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const TITLE = l(
  "Timeline April to November 2026: the delivery-flow contract runs unbroken while the workspace tool beneath it swaps twice; after version 7 no swap touched it",
  "Časová osa duben až listopad 2026: kontrakt delivery flow běží nepřerušeně, zatímco nástroj na pracoviště pod ním se dvakrát vymění; od verze 7 se ho žádná výměna nedotkla",
);
const DESC = l(
  "Top lane: the contract, versions v1 to v10, one continuous line from August; v5 came with the Superset move and v7 separated checkout from session, after which the Paseo move and the T3 Code evaluation changed only personal-layer files. Middle lane: workspace and agent tool, cmux until August, Superset for three weeks, Paseo from September; T3 Code appears twice as a dotted trial. Bottom lane: worktrunk as the team default for checkouts the whole time.",
  "Horní dráha: kontrakt, verze v1 až v10, jedna souvislá čára od srpna; v5 přišla s přechodem na Superset a v7 oddělila checkout od session, od té doby přechod na Paseo i hodnocení T3 Code změnily jen soubory osobní vrstvy. Prostřední dráha: nástroj na pracoviště a agenty, cmux do srpna, Superset tři týdny, Paseo od září; T3 Code dvakrát jako tečkovaná zkouška. Dolní dráha: worktrunk jako týmový default pro checkouty po celou dobu.",
);

const MONTHS = l("Apr|May|Jun|Jul|Aug|Sep|Oct|Nov", "dub|kvě|čvn|čvc|srp|zář|říj|lis")[locale].split("|");
const LANES = {
  contract: l("delivery-flow contract", "kontrakt delivery flow"),
  tools: l("workspaces & agents", "pracoviště a agenti"),
  checkout: l("checkout", "checkout"),
};
const BEFORE = l("personal skills, no contract yet", "osobní skilly, zatím bez kontraktu");
const CONTRACT = l("contract v1 → v10 · from v7 on, no swap touched it", "kontrakt v1 → v10 · od v7 se ho žádná výměna nedotkla");
const TRIAL = l("T3 Code trial", "zkouška T3 Code");
const PROBE = l("T3 Code probe", "sonda T3 Code");
const DEFAULT = l("worktrunk · team default", "worktrunk · týmový default");
const LEGEND = l(
  "v5 came with the move to Superset; v7 split checkout from session.|From then on, the move to Paseo and the T3 Code evaluation changed only personal-layer files.",
  "v5 přišla s přechodem na Superset; v7 oddělila checkout od session.|Od té doby přechod na Paseo i hodnocení T3 Code změnily jen soubory osobní vrstvy.",
);

const W = 920;
const H = 334;
const X0 = 150;
const X1 = 900;
const PER_MONTH = (X1 - X0) / 8;
/** 2026-MM-DD → x; April = month index 0. */
const x = (iso: string) => {
  const [, m, d] = iso.split("-").map(Number);

  return +(X0 + (m - 4 + (d - 1) / 30) * PER_MONTH).toFixed(1);
};
const Y = { contract: 72, tools: 160, trial: 206, checkout: 268 };
const BAR = 30;

const bars = [
  { label: "cmux", from: "2026-04-21", to: "2026-08-19", cls: "", above: false },
  { label: "Superset", from: "2026-08-19", to: "2026-09-07", cls: "", above: true },
  { label: "Paseo", from: "2026-09-07", to: "2026-11-03", cls: "now", above: false },
];
const trials = [
  { label: TRIAL[locale], from: "2026-08-26", width: 96 },
  { label: PROBE[locale], from: "2026-10-13", width: 112 },
];
const versions = [
  ["v1", "2026-08-06", 0],
  ["v5", "2026-08-23", 0],
  ["v7", "2026-08-27", 1],
  ["v8", "2026-09-07", 0],
  ["v10", "2026-09-24", 0],
] as const;
const contractStart = x("2026-08-06");
const contractEnd = x("2026-11-03");
---

<div class="scroll" tabindex="0" role="region" aria-label={TITLE[locale]}>
  <svg
    class="swim"
    data-diagram="tool-swimlane"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby="tool-swimlane-t"
    aria-describedby="tool-swimlane-d"
  >
    <title id="tool-swimlane-t">{TITLE[locale]}</title>
    <desc id="tool-swimlane-d">{DESC[locale]}</desc>

    {
      MONTHS.map((m, i) => (
        <g class="month">
          <line x1={X0 + i * PER_MONTH} y1="24" x2={X0 + i * PER_MONTH} y2={H - 30} />
          <text x={X0 + i * PER_MONTH + 6} y="18" font-size="12">
            {m}
          </text>
        </g>
      ))
    }

    <text class="lane" x="16" y={Y.contract + 5} font-size="13">{LANES.contract[locale]}</text>
    <text class="lane" x="16" y={Y.tools + 5} font-size="13">{LANES.tools[locale]}</text>
    <text class="lane" x="16" y={Y.checkout + 5} font-size="13">{LANES.checkout[locale]}</text>

    <g class="contract">
      <line class="before" x1={x("2026-04-21")} y1={Y.contract} x2={contractStart} y2={Y.contract} />
      <text class="before-t" x={x("2026-04-21") + 4} y={Y.contract - 12} font-size="12">{BEFORE[locale]}</text>
      <line class="draw" x1={contractStart} y1={Y.contract} x2={contractEnd} y2={Y.contract} pathLength="1" />
      {
        versions.map(([v, d, row]) => (
          <g class="ver">
            <circle cx={x(d)} cy={Y.contract} r="4.5" />
            <text x={x(d)} y={Y.contract + 22 + row * 15} text-anchor="middle" font-size="12">
              {v}
            </text>
          </g>
        ))
      }
      <text class="contract-t" x={contractStart} y={Y.contract - 12} font-size="13">{CONTRACT[locale]}</text>
    </g>

    {
      bars.map((b) => (
        <g class:list={["bar", b.cls]}>
          <rect x={x(b.from)} y={Y.tools - BAR / 2} width={x(b.to) - x(b.from)} height={BAR} rx="6" />
          <text class:list={{ above: b.above }} x={x(b.from) + (b.above ? 0 : 10)} y={b.above ? Y.tools - BAR / 2 - 7 : Y.tools + 5} font-size="13">
            {b.label}
          </text>
        </g>
      ))
    }
    {
      trials.map((t) => (
        <g class="trial">
          <rect x={x(t.from)} y={Y.trial - 12} width={t.width} height="24" rx="12" />
          <text x={x(t.from) + 10} y={Y.trial + 4.5} font-size="12">
            {t.label}
          </text>
        </g>
      ))
    }

    <g class="bar default">
      <rect x={x("2026-04-21")} y={Y.checkout - BAR / 2} width={contractEnd - x("2026-04-21")} height={BAR} rx="6" />
      <text x={x("2026-04-21") + 10} y={Y.checkout + 5} font-size="13">{DEFAULT[locale]}</text>
    </g>

    {LEGEND[locale].split("|").map((line, i) => (
      <text class="legend" x="16" y={H - 22 + i * 16} font-size="12.5">
        {line}
      </text>
    ))}
  </svg>
</div>

<style>
  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    margin-top: 28px;
  }
  .swim {
    display: block;
    width: 100%;
    /* At a 390 px phone the box is ≈ 358 px wide and scrolls; 860 / 920 viewBox keeps 12 px labels ≥ 11 px rendered. */
    min-width: 860px;
    overflow: visible;
  }
  .month line {
    stroke: var(--line);
    stroke-dasharray: 2 5;
  }
  .month text,
  .lane,
  .legend {
    fill: var(--mute);
  }
  .lane {
    font-weight: 600;
    fill: var(--ink);
  }
  .contract .before {
    stroke: var(--line);
    stroke-width: 2;
    stroke-dasharray: 4 6;
  }
  .before-t {
    fill: var(--mute);
  }
  .contract .draw {
    stroke: var(--acc);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .ver circle {
    fill: var(--bg);
    stroke: var(--acc);
    stroke-width: 2;
  }
  .ver text {
    fill: var(--mute);
    font-variant-numeric: tabular-nums;
  }
  .contract-t {
    fill: var(--ink);
    font-weight: 700;
  }
  .bar rect {
    fill: var(--tint);
    stroke: var(--line);
  }
  .bar text {
    fill: var(--ink);
    font-weight: 600;
  }
  .bar.now rect {
    fill: var(--ink);
    stroke: var(--ink);
  }
  .bar.now text {
    fill: var(--bg);
  }
  .bar text.above {
    fill: var(--mute);
  }
  .trial rect {
    fill: none;
    stroke: var(--mute);
    stroke-dasharray: 3 4;
  }
  .trial text {
    fill: var(--mute);
  }
  @media (prefers-reduced-motion: no-preference) {
    .contract .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: swim-draw 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s forwards;
    }
  }
  @keyframes swim-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
