---
/**
 * The map of smaller wins: one lane per area, months May – November 2026 across, every win a numbered chip
 * placed at the month it started and linked to its card below. Chips that would overlap move to a second row.
 */
import { AREAS, MONTHS, YEAR, winsIn, type Win } from "../../data/alongTheWay";
import { l } from "../../data/l10n";
import type { Locale } from "../../i18n/locales";
import ScrollHint from "../ScrollHint.astro";

interface Props {
  locale: Locale;
  /** Number of each win, as printed on its card. */
  numbers: Map<string, number>;
}

const { locale, numbers } = Astro.props;

const LABEL = l(
  "Map of the smaller wins by area and month, May to November 2026; each item links to its card",
  "Mapa menších výher podle oblasti a měsíce, květen až listopad 2026; každá položka odkazuje na svou kartu",
);

/** Columns a chip needs for its label (about 7.5 px per character at the chip size, ~90 px per month). */
const need = (w: Win) => Math.max(w.to - w.from + 1, Math.ceil((w.short[locale].length * 7.5 + 44) / 100));

const lanes = AREAS.map((a) => {
  const rows: number[][] = [];
  const placed = winsIn(a.id).map((w) => {
    const span = Math.min(need(w), MONTHS.length - w.from);
    const start = Math.max(0, Math.min(w.from, MONTHS.length - span));
    let row = rows.findIndex((r) => r.every((c, i) => !c || i < start || i >= start + span));
    if (row === -1) row = rows.push(Array(MONTHS.length).fill(0)) - 1;
    for (let i = start; i < start + span; i++) rows[row][i] = 1;
    return { w, start, span, row };
  });
  return { a, placed, rows: Math.max(rows.length, 1) };
});
---

<div class="scroll hscroll" tabindex="0" role="region" aria-label={LABEL[locale]}>
  <figure class="map" data-diagram="wins-map" style={`--months: ${MONTHS.length}`}>
    <figcaption class="sr">{LABEL[locale]}</figcaption>
    <div class="axis" aria-hidden="true">
      <span class="year">{YEAR}</span>
      {MONTHS.map((m) => <span>{m[locale]}</span>)}
    </div>
    {
      lanes.map(({ a, placed, rows }) => (
        <div class="lane" data-area={a.id}>
          <a class="area" href={`#area-${a.id}`}>{a.title[locale]}</a>
          <ul class="chips" style={`--rows: ${rows}`}>
            {placed.map(({ w, start, span, row }) => (
              <li style={`--col: ${start + 1} / span ${span}; --row: ${row + 1}`}>
                <a href={`#win-${w.id}`} data-win-link={w.id}>
                  <b>{numbers.get(w.id)}</b>
                  <span>{w.short[locale]}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </figure>
</div>
<ScrollHint locale={locale} />

<style>
  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    margin-top: 2.25rem;
  }
  .map {
    margin: 0;
    /* Each month gets ~100 px next to the lane label; under 800 px the map becomes plain lists per area. */
    --label: 10.5rem;
  }
  .axis,
  .lane {
    display: grid;
    grid-template-columns: var(--label) repeat(var(--months), minmax(0, 1fr));
    column-gap: 0.25rem;
  }
  .axis {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--mute);
  }
  .axis .year {
    color: var(--acc-text);
    font-weight: 700;
  }
  .lane {
    align-items: start;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--line);
  }
  .area {
    padding-top: 0.25rem;
    padding-right: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
  }
  .area:hover {
    color: var(--acc-text);
  }
  .chips {
    grid-column: 2 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--months), minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    gap: 0.375rem 0.25rem;
  }
  .chips li {
    min-width: 0;
    grid-column: var(--col);
    grid-row: var(--row);
  }
  .chips a {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem 0.25rem 0.25rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--acc);
    border-radius: 0.375rem;
    background: var(--tint);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
  }
  .chips a:hover {
    border-color: var(--acc);
  }
  .chips b {
    flex: none;
    min-width: 1.25rem;
    text-align: center;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--acc-text);
  }
  .chips span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Narrow screens: no month axis (every card carries its period), each area a wrapped list of chips. */
  @media (max-width: 799px) {
    .axis {
      display: none;
    }
    .lane {
      grid-template-columns: 1fr;
      row-gap: 0.5rem;
    }
    .chips {
      grid-column: 1;
      display: flex;
      flex-wrap: wrap;
    }
    .chips span {
      white-space: normal;
    }
  }
</style>
