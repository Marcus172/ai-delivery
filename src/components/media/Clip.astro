---
/**
 * A short screen recording in a case: muted, looping, with native controls. It starts on its own only
 * when the visitor has not asked for reduced motion; otherwise it waits on its poster frame.
 * Prefer mp4/webm over GIF (smaller, and it can be paused). Recordings are not covered by the NDA gate.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  /** URL of the video file, e.g. `import clip from "../../assets/wins/x/demo.mp4"`. */
  src: string;
  type?: "video/mp4" | "video/webm";
  poster: ImageMetadata;
  /** What the clip shows, for people who cannot see it. */
  label: string;
  caption: string;
}

const { src, type = "video/mp4", poster, label, caption } = Astro.props;
const posterImg = await getImage({ src: poster, width: Math.min(poster.width, 1200) });
---

<figure class="media clip" data-media="clip">
  <div class="frame">
    <video muted loop playsinline controls preload="metadata" poster={posterImg.src} aria-label={label} data-clip>
      <source src={src} type={type} />
    </video>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");
  for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-clip]")) {
    if (still.matches) continue;
    video.autoplay = true;
    video.play().catch(() => {});
  }
</script>

<style>
  .media {
    margin: 2rem 0 0;
  }
  .frame {
    padding: 0.5rem;
    background: var(--tint);
    border: 1px solid var(--line);
    border-radius: 0.875rem;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
  figcaption {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    color: var(--mute);
  }
</style>
