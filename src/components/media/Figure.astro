---
/**
 * A still image in a case (screenshot, exported diagram). Alt and caption are required; the image links
 * to its full-size file. Screenshots are not covered by the NDA gate: check every pixel before adding one.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Locale } from "../../i18n/locales";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Natural width to render at most, in CSS px (default: the image's own width, capped at 1200). */
  width?: number;
}

const { locale, src, alt, caption, width = Math.min(src.width, 1200) } = Astro.props;
---

<figure class="media figure" data-media="figure">
  <a class="frame" href={src.src} aria-label={`${t(locale, "media.full")}: ${alt}`}>
    <Image src={src} alt={alt} width={width} widths={[Math.round(width / 2), width]} sizes={`(max-width: 899px) 100vw, ${width}px`} loading="lazy" />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .media {
    margin: 2rem 0 0;
    max-width: 56rem;
  }
  .frame {
    display: block;
    padding: 0.5rem;
    background: var(--tint);
    border: 1px solid var(--line);
    border-radius: 0.875rem;
  }
  .frame:hover {
    border-color: var(--acc);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
  figcaption {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    color: var(--mute);
    max-width: 68ch;
  }
</style>
