---
/**
 * A still image in a case (screenshot, exported diagram). Alt and caption are required. The image links
 * to its full-size file; with JS the link opens a native <dialog> that fits the image to the viewport
 * (Esc, the close button or a click beside the image closes it). Screenshots are not covered by the NDA gate: check every pixel before adding one.
 */
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";
import type { Locale } from "../../i18n/locales";
import { t } from "../../i18n/ui";

interface Props {
  locale: Locale;
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Natural width to render at most, in CSS px (default: the image's own width, capped at 1200). */
  width?: number;
}

const { locale, src, alt, caption, width = Math.min(src.width, 1200) } = Astro.props;
// The full-size link goes through the image pipeline too: a raw asset URL only works as an <img> source in dev, not
// as a page the browser navigates to.
const full = await getImage({ src, width: src.width, format: src.format === "jpg" ? "jpeg" : src.format });
---

<figure class="media figure" data-media="figure">
  <a class="frame" href={full.src} aria-label={`${t(locale, "media.full")}: ${alt}`}>
    <Image src={src} alt={alt} width={width} widths={[Math.round(width / 2), width]} sizes={`(max-width: 899px) 100vw, ${width}px`} loading="lazy" />
  </a>
  <figcaption>{caption}</figcaption>
  <dialog class="zoom" aria-label={alt} data-zoom>
    <div class="sheet">
      <div class="bar">
        <p>{caption}</p>
        <button type="button" class="close" data-close aria-label={t(locale, "media.close")}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
      <div class="canvas">
        <img src={full.src} alt={alt} width={full.attributes.width ?? src.width} height={full.attributes.height ?? src.height} loading="lazy" decoding="async" />
      </div>
    </div>
  </dialog>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>("[data-media=figure]")) {
    const link = fig.querySelector<HTMLAnchorElement>("a.frame");
    const dialog = fig.querySelector<HTMLDialogElement>("dialog[data-zoom]");
    if (!link || !dialog || typeof dialog.showModal !== "function") continue;
    link.addEventListener("click", (e) => {
      // A modified click still opens the plain file in a new tab.
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      dialog.showModal();
    });
    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.closest("[data-close]")) dialog.close();
    });
  }
</script>

<style>
  .media {
    margin: 2rem 0 0;
    max-width: 56rem;
  }
  .frame {
    display: block;
    padding: 0.5rem;
    background: var(--tint);
    border: 1px solid var(--line);
    border-radius: 0.875rem;
  }
  .frame:hover {
    border-color: var(--acc);
  }
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
  .zoom {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.5rem;
    border: 0;
    background: transparent;
    color: var(--ink);
  }
  .zoom[open] {
    display: grid;
    place-items: center;
  }
  .zoom::backdrop {
    background: rgb(10 12 14 / 0.82);
  }
  :global(html:has(dialog[data-zoom][open])) {
    overflow: hidden;
  }
  .sheet {
    display: grid;
    gap: 0.625rem;
    max-width: 100%;
    max-height: 100%;
    padding: 0.75rem;
    background: var(--bg);
    border-radius: 0.875rem;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .bar p {
    font-size: 0.875rem;
    color: var(--mute);
  }
  .close {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .close:hover {
    border-color: var(--acc);
  }
  .close svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .canvas {
    min-height: 0;
    overflow: auto;
    border-radius: 0.5rem;
  }
  /* Fit the whole screenshot into the viewport: the bar and the paddings take about 7rem. */
  .sheet img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 7rem);
    margin-inline: auto;
    border-radius: 0.5rem;
  }
  /* On a phone a whole screenshot is too small to read: show it at a readable width and let it scroll. */
  @media (max-width: 699px) {
    .zoom {
      padding: 0.75rem;
    }
    .sheet {
      height: 100%;
      grid-template-rows: auto minmax(0, 1fr);
    }
    .canvas {
      max-height: none;
    }
    .sheet img {
      max-width: none;
      max-height: none;
      width: 62.5rem;
      margin-inline: 0;
    }
  }
  figcaption {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    color: var(--mute);
    max-width: 68ch;
  }
</style>
