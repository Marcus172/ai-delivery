---
import "../styles/global.css";
import type { Locale } from "../i18n/locales";
import { LOCALES } from "../i18n/locales";
import { href, localizedPath, subPagePath, type PageId } from "../i18n/routes";
import { t } from "../i18n/ui";
import Rail from "../components/Rail.astro";
import CtaRow from "../components/CtaRow.astro";
import Eyebrow from "../components/Eyebrow.astro";

interface Props {
  locale: Locale;
  page: PageId;
  /** Subpage segment under `page` (a case under `wins`); the rail still marks `page` as current. */
  sub?: string;
  title: string;
  description: string;
}

const { locale, page, sub, title, description } = Astro.props;
const siteName = t(locale, "site.name");
const fullTitle = title === siteName || title.startsWith(`${siteName} `) ? title : `${title} — ${siteName}`;
const site = Astro.site ?? new URL("http://localhost:4321/");
const pathIn = (l: Locale) => (sub ? subPagePath(l, page, sub) : localizedPath(l, page));
const alternate = (l: Locale) => new URL(pathIn(l), site).href;
const year = new Date().getFullYear();
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={alternate(l)} />)}
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("favicon.ico")} sizes="any" />
    <link rel="alternate" hreflang="x-default" href={alternate("en")} />
    <script is:inline>
      (function () {
        var theme = null;
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") theme = stored;
        } catch (e) {}
        if (!theme) {
          theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{t(locale, "skip")}</a>
    <div class="progress" aria-hidden="true" data-progress></div>
    <div class="shell">
      <Rail locale={locale} page={page} sub={sub} />
      <div class="page">
        <main id="content" class="wrap" tabindex="-1">
          <slot />
        </main>
        <footer class="wrap">
          <div class="contact">
            <div>
              <Eyebrow>{t(locale, "footer.eyebrow")}</Eyebrow>
              <h2>{t(locale, "footer.title")}</h2>
              <p>{t(locale, "footer.text")}</p>
            </div>
            <CtaRow locale={locale} />
          </div>
          <div class="colophon">
            <span>© {year} {siteName}</span>
            <span>{t(locale, "footer.built")}</span>
          </div>
        </footer>
      </div>
    </div>
    <script>
      const bar = document.querySelector<HTMLElement>("[data-progress]");
      let ticking = false;
      const update = () => {
        ticking = false;
        if (!bar) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -6.25rem;
    z-index: 60;
    padding: 0.625rem 0.875rem;
    border-radius: 0.625rem;
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
  }
  .skip:focus-visible {
    top: 0.75rem;
  }
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 0.1875rem;
    width: 0;
    background: var(--acc);
    z-index: 40;
    transition: width 0.1s linear;
  }
  .shell {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    min-height: 100vh;
  }
  .page {
    min-width: 0;
    padding-inline: max(1.5rem, env(safe-area-inset-left, 0px)) max(1.5rem, env(safe-area-inset-right, 0px));
  }
  main {
    padding-block: 3.5rem 4.5rem;
  }
  main:focus {
    outline: none;
  }
  footer {
    padding-block: 0 2.5rem;
  }
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    background: var(--ink);
    color: var(--bg);
    border-radius: 1.125rem;
    padding: 2.75rem;
  }
  .contact h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 0.95;
    margin: 0 0 0.875rem;
  }
  .contact p {
    opacity: 0.8;
    max-width: 46ch;
  }
  .contact :global(.eyebrow) {
    color: var(--bg);
    opacity: 0.7;
  }
  .contact :global(.eyebrow::before) {
    background: var(--acc);
  }
  .contact :global(.btn) {
    background: var(--bg);
    color: var(--ink);
    border-color: var(--bg);
  }
  .contact :global(.btn.ghost) {
    background: transparent;
    color: var(--bg);
    border-color: color-mix(in srgb, var(--bg) 40%, transparent);
  }
  .contact :global(.btn.ghost:hover) {
    border-color: var(--bg);
  }
  .colophon {
    padding: 1.75rem 0 0;
    color: var(--mute);
    font-size: 0.8125rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  @media (max-width: 899px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .page {
      padding-inline: max(1rem, env(safe-area-inset-left, 0px)) max(1rem, env(safe-area-inset-right, 0px));
    }
    main {
      padding-block: 2.5rem 3.5rem;
    }
    .contact {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.375rem;
    }
  }
  @media print {
    .skip,
    .progress,
    footer {
      display: none;
    }
    .shell {
      display: block;
      min-height: 0;
    }
    .page,
    main {
      padding: 0;
    }
  }
</style>
