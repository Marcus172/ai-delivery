---
import Base from "../layouts/Base.astro";
import JourneyView from "../views/JourneyView.astro";
import { t } from "../i18n/ui";

const locale = "en";
const page = "journey";
---

<Base locale={locale} page={page} title={t(locale, "page.journey.title")} description={t(locale, "page.journey.description")}>
  <JourneyView locale={locale} />
</Base>
