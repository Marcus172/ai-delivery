---
import { getCollection, render } from "astro:content";
import Eyebrow from "../components/Eyebrow.astro";
import { csTypo } from "../data/l10n";
import { AS_OF } from "../data/metrics";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entries = (await getCollection("aiDelivery", ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const typo = (s: string) => (locale === "cs" ? csTypo(s) : s);
const chapters = await Promise.all(
  entries.map(async (entry) => ({
    ...entry.data,
    title: typo(entry.data.title),
    summary: typo(entry.data.summary),
    Content: (await render(entry)).Content,
  })),
);
const num = (order: number) => String(order).padStart(2, "0");
---

<header class="head">
  <Eyebrow>{t(locale, "ai.eyebrow")}</Eyebrow>
  <h1>{t(locale, "ai.title")}</h1>
  <p class="lead">{t(locale, "ai.lead")}</p>
  <p class="as-of">{t(locale, "ai.asOf")}</p>
</header>

<details class="toc-details" data-toc-details>
  <summary>{t(locale, "ai.toc")}</summary>
  <nav data-toc aria-label={t(locale, "ai.toc")}>
    <ol>
      {
        chapters.map((c) => (
          <li>
            <a href={`#${c.id}`}>
              <span class="n">{num(c.order)}</span>
              {c.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</details>

<div class="layout">
  <article class="chapters">
    {
      chapters.map((c) => (
        <section id={c.id} class="chapter" data-chapter aria-labelledby={`${c.id}-title`}>
          <Eyebrow>
            <span data-chapter-number>
              {t(locale, "ai.chapter")} {num(c.order)}
            </span>
          </Eyebrow>
          <h2 id={`${c.id}-title`}>{c.title}</h2>
          <p class="summary">{c.summary}</p>
          <div class="body">
            <c.Content />
          </div>
        </section>
      ))
    }
  </article>

  <aside class="toc-side">
    <div class="toc-wrap" data-toc-wrap>
      <p class="toc-title">{t(locale, "ai.toc")}</p>
      <nav data-toc aria-label={t(locale, "ai.toc")}>
        <ol>
          {
            chapters.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="n">{num(c.order)}</span>
                  {c.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="toc-note">{AS_OF[locale]}</p>
    </div>
  </aside>
</div>

<script>
  // Mark the chapter in view in the side TOC. No motion, no scroll hijacking: links stay plain anchors.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-side nav[data-toc] a"));
  const sections = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute("href") ?? ""))
    .filter((s): s is HTMLElement => !!s);
  if (links.length && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const mark = () => {
      const current = sections.find((s) => visible.has(s.id))?.id;
      for (const a of links) {
        if (a.getAttribute("href") === `#${current}`) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        mark();
      },
      { rootMargin: "-20% 0px -60% 0px" },
    );
    for (const s of sections) io.observe(s);
  }
</script>

<style>
  .head {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .head h1 {
    font-size: clamp(3rem, 6.2vw, 5.75rem);
    max-width: 14ch;
  }
  .head .lead {
    margin-top: 1.5rem;
    max-width: 64ch;
  }
  .as-of {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--mute);
  }

  /* ---------- TOC ---------- */
  nav[data-toc] ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav[data-toc] li + li {
    margin-top: 2px;
  }
  nav[data-toc] a {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.4375rem 0.625rem 0.4375rem 0.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-size: 0.875rem;
    color: var(--mute);
    border-left: 2px solid transparent;
  }
  nav[data-toc] a:hover {
    color: var(--ink);
    background: var(--tint);
  }
  nav[data-toc] a[aria-current="true"] {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--acc);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  nav[data-toc] .n {
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--acc-text);
  }
  .toc-details {
    margin-top: 1.25rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.75rem;
  }
  .toc-details summary {
    cursor: pointer;
    list-style: none;
    padding: 0.875rem 0;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .toc-details summary::-webkit-details-marker {
    display: none;
  }
  .toc-details summary::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    flex: none;
    margin-left: 2px;
  }
  .toc-details[open] summary::before {
    transform: rotate(45deg);
  }
  .toc-side {
    display: none;
  }
  .toc-wrap {
    position: sticky;
    top: 1.75rem;
    padding-top: 0.5rem;
  }
  .toc-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--mute);
    margin: 0 0 0.625rem 0.5rem;
  }
  .toc-note {
    margin: 1.125rem 0 0 0.5rem;
    font-size: 0.75rem;
    color: var(--mute);
  }

  /* ---------- layout ---------- */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .chapters {
    min-width: 0;
  }
  .chapter {
    padding-block: 4rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 0.75rem;
  }
  .chapter:first-child {
    border-top: 0;
    padding-top: 2.5rem;
  }
  .chapter h2 {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    max-width: 18ch;
  }
  .summary {
    margin-top: 1.125rem;
    font-size: 1.125rem;
    color: var(--mute);
    max-width: 60ch;
  }
  .body {
    margin-top: 1.75rem;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol),
  .body :global(h3) {
    max-width: 68ch;
  }
  .body :global(p + p),
  .body :global(ul + p),
  .body :global(p + ul) {
    margin-top: 1rem;
  }
  .body :global(h3) {
    margin-top: 2.5rem;
  }
  .body :global(h3 + p) {
    margin-top: 0.625rem;
  }
  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.375rem;
  }
  .body :global(li + li) {
    margin-top: 0.375rem;
  }
  .body :global(strong) {
    font-weight: 700;
  }
  .body :global(.stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    gap: 1.5rem 1.75rem;
    margin-top: 2rem;
    max-width: 47.5rem;
  }
  .body :global(.stats + p),
  .body :global(.band + p),
  .body :global(.scroll + p),
  .body :global(.note + p),
  .body :global(.stat + p) {
    margin-top: 2rem;
  }
  .body :global(.stat) {
    margin-top: 1.75rem;
  }
  .body :global(.stats .stat) {
    margin-top: 0;
  }
  .body :global(.example) {
    margin-top: 1.75rem;
    padding: 1.375rem 1.5rem;
    background: var(--tint);
    border-radius: 0.875rem;
    max-width: 68ch;
  }
  .body :global(.example p + p) {
    margin-top: 0.625rem;
  }
  .body :global(.example .k) {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
    margin-bottom: 0.5rem;
  }

  .body :global(.caveats) {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16.25rem, 1fr));
    gap: 1.25rem 1.75rem;
    max-width: 53.75rem;
  }
  .body :global(.caveats li) {
    margin: 0;
    padding: 1rem 1.125rem;
    background: var(--tint);
    border-radius: 0.75rem;
    font-size: 0.875rem;
    color: var(--mute);
    line-height: 1.5;
  }
  .body :global(.caveats li strong) {
    color: var(--ink);
  }
  .body :global(.caveats .stat) {
    margin-top: 0;
  }
  .body :global(.caveats + h3) {
    margin-top: 3rem;
  }
  .body :global(.estimate) {
    margin-top: 1rem;
    padding: 1.125rem 1.375rem;
    border: 1px dashed var(--line);
    border-radius: 0.875rem;
    max-width: 68ch;
    color: var(--mute);
  }
  .body :global(.estimate a) {
    color: var(--ink);
  }

  @media (min-width: 1100px) {
    .toc-details {
      display: none;
    }
    .layout {
      grid-template-columns: minmax(0, 1fr) 14.5rem;
      gap: 3.5rem;
    }
    .toc-side {
      display: block;
    }
  }
  @media (max-width: 899px) {
    .head {
      padding-bottom: 2rem;
    }
    .chapter {
      padding-block: 2.75rem;
    }
    .chapter:first-child {
      padding-top: 1.75rem;
    }
  }
</style>
