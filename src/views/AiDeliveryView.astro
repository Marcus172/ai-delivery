---
import { getCollection, render } from "astro:content";
import Eyebrow from "../components/Eyebrow.astro";
import Prose from "../components/Prose.astro";
import { loadCases } from "../data/cases";
import { csTypo } from "../data/l10n";
import { AS_OF } from "../data/metrics";
import type { Locale } from "../i18n/locales";
import { localizedPath, subPagePath } from "../i18n/routes";
import { t, type UiKey } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entries = (await getCollection("aiDelivery", ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const typo = (s: string) => (locale === "cs" ? csTypo(s) : s);
const chapters = await Promise.all(
  entries.map(async (entry) => ({
    ...entry.data,
    title: typo(entry.data.title),
    summary: typo(entry.data.summary),
    Content: (await render(entry)).Content,
  })),
);
const num = (order: number) => String(order).padStart(2, "0");
const tt = (key: UiKey) => typo(t(locale, key));
const cases = await loadCases(locale);
// Old anchors from before the cases moved to Wins & cases; links to them are already out there.
const moved: Record<string, string> = {
  results: localizedPath(locale, "wins", "results"),
  "case-persona": subPagePath(locale, "wins", "brand-voice"),
  "case-a11y": subPagePath(locale, "wins", "accessibility"),
  "case-tailwind": subPagePath(locale, "wins", "tailwind"),
};
---

<script is:inline define:vars={{ moved }}>
  // Forward an old chapter anchor to its new page before anything paints.
  var target = moved[location.hash.slice(1)];
  if (target) location.replace(target);
</script>

<header class="head">
  <Eyebrow>{t(locale, "ai.eyebrow")}</Eyebrow>
  <h1>{t(locale, "ai.title")}</h1>
  <p class="lead">{t(locale, "ai.lead")}</p>
  <p class="as-of">{t(locale, "ai.asOf")}</p>
</header>

<details class="toc-details" data-toc-details data-toc-bar>
  <summary>
    <span class="toc-label">{t(locale, "ai.toc")}</span>
    <span class="toc-current" data-toc-current></span>
  </summary>
  <nav data-toc aria-label={t(locale, "ai.toc")}>
    <ol>
      {
        chapters.map((c) => (
          <li>
            <a href={`#${c.id}`}>
              <span class="n">{num(c.order)}</span>
              {c.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</details>

<div class="layout">
  <article class="chapters">
    {
      chapters.map((c) => (
        <>
        {c.id === "offer" && (
          <aside class="bridge" aria-labelledby="bridge-title" data-wins-bridge>
            <Eyebrow>{tt("ai.bridgeEyebrow")}</Eyebrow>
            <h2 id="bridge-title">{tt("ai.bridgeTitle")}</h2>
            <p class="summary">{tt("ai.bridgeText")}</p>
            <ul class="bridge-links">
              {cases.map((k) => (
                <li>
                  <a href={subPagePath(locale, "wins", k.id)}>{k.title}</a>
                </li>
              ))}
            </ul>
            <a class="bridge-all" href={localizedPath(locale, "wins")}>
              {tt("ai.bridgeLink")}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </aside>
        )}
        <section id={c.id} class="chapter" data-chapter aria-labelledby={`${c.id}-title`}>
          <Eyebrow>
            <span data-chapter-number>
              {t(locale, "ai.chapter")} {num(c.order)}
            </span>
          </Eyebrow>
          <h2 id={`${c.id}-title`}>{c.title}</h2>
          <p class="summary">{c.summary}</p>
          <Prose>
            <c.Content />
          </Prose>
        </section>
        </>
      ))
    }
  </article>

  <aside class="toc-side">
    <div class="toc-wrap" data-toc-wrap>
      <p class="toc-title">{t(locale, "ai.toc")}</p>
      <nav data-toc aria-label={t(locale, "ai.toc")}>
        <ol>
          {
            chapters.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="n">{num(c.order)}</span>
                  {c.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="toc-note">{AS_OF[locale]}</p>
    </div>
  </aside>
</div>

<script>
  // Mark the chapter in view in both TOCs (side list on desktop, bar on mobile). No motion, no scroll
  // hijacking: links stay plain anchors.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("nav[data-toc] a"));
  const sections = Array.from(new Set(links.map((a) => a.getAttribute("href") ?? "")))
    .map((h) => document.querySelector<HTMLElement>(h))
    .filter((s): s is HTMLElement => !!s);
  const bar = document.querySelector<HTMLDetailsElement>("[data-toc-bar]");
  const current = bar?.querySelector<HTMLElement>("[data-toc-current]");
  const root = document.documentElement;
  // The mobile rail and the chapter bar are sticky; their heights keep anchors from landing under them.
  const measure = () => {
    const rail = document.querySelector<HTMLElement>(".rail");
    const narrow = matchMedia("(max-width: 899px)").matches;
    root.style.setProperty("--rail-h", `${narrow && rail ? rail.offsetHeight : 0}px`);
    root.style.setProperty("--bar-h", `${narrow && bar ? bar.querySelector("summary")!.offsetHeight : 0}px`);
  };
  measure();
  addEventListener("resize", measure);
  for (const a of links) a.addEventListener("click", () => bar?.removeAttribute("open"));
  if (links.length && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const mark = () => {
      const section = sections.find((s) => visible.has(s.id));
      for (const a of links) {
        if (section && a.getAttribute("href") === `#${section.id}`) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
      if (current) {
        const n = section?.querySelector("[data-chapter-number]")?.textContent?.match(/\d+/)?.[0];
        const h = section?.querySelector("h2")?.textContent?.trim();
        current.textContent = section && h ? `· ${n} ${h}` : "";
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        mark();
      },
      { rootMargin: "-20% 0px -60% 0px" },
    );
    for (const s of sections) io.observe(s);
  }
</script>

<style>
  .head {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .head h1 {
    font-size: var(--page-title-size);
    max-width: 20ch;
  }
  .head .lead {
    margin-top: 1.5rem;
  }
  .as-of {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--mute);
  }

  /* ---------- TOC ---------- */
  nav[data-toc] ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav[data-toc] li + li {
    margin-top: 2px;
  }
  nav[data-toc] a {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.4375rem 0.625rem 0.4375rem 0.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-size: 0.875rem;
    color: var(--mute);
    border-left: 2px solid transparent;
  }
  nav[data-toc] a:hover {
    color: var(--ink);
    background: var(--tint);
  }
  nav[data-toc] a[aria-current="true"] {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--acc);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  nav[data-toc] .n {
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--acc-text);
  }
  .toc-details {
    margin-top: 1.25rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.75rem;
  }
  .toc-details summary {
    cursor: pointer;
    list-style: none;
    padding: 0.875rem 0;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .toc-label {
    flex: none;
  }
  .toc-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
    color: var(--mute);
  }
  .toc-details summary::-webkit-details-marker {
    display: none;
  }
  .toc-details summary::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    flex: none;
    margin-left: 2px;
  }
  .toc-details[open] summary::before {
    transform: rotate(45deg);
  }
  .toc-side {
    display: none;
  }
  .toc-wrap {
    position: sticky;
    top: 1.75rem;
    padding-top: 0.5rem;
  }
  .toc-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--mute);
    margin: 0 0 0.625rem 0.5rem;
  }
  .toc-note {
    margin: 1.125rem 0 0 0.5rem;
    font-size: 0.75rem;
    color: var(--mute);
  }

  /* ---------- layout ---------- */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .chapters {
    min-width: 0;
  }
  .chapter {
    padding-block: 4rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--rail-h, 0px) + var(--bar-h, 0px) + 1rem);
  }
  .chapter:first-child {
    border-top: 0;
    padding-top: 2.5rem;
  }
  .chapter h2 {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    max-width: 18ch;
  }
  .summary {
    margin-top: 1.125rem;
    font-size: 1.125rem;
    color: var(--mute);
  }
  /* AI Delivery explains how the system works: figures stand without the measured badge and period
     (those live on Wins & cases). Only the estimate keeps its badge, so it never reads as measured. */
  .chapters :global(.stat[data-kind="measured"] > small),
  .chapters :global(.stat > .period) {
    display: none;
  }

  /* ---------- bridge to Wins & cases ---------- */
  .bridge {
    margin-block: 1rem 0;
    padding: 2rem 2rem 1.75rem;
    background: var(--tint);
    border-top: 2px solid var(--acc);
    border-radius: 0 0 1rem 1rem;
  }
  .bridge h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 20ch;
  }
  .bridge-links {
    margin: 1.5rem 0 0;
    padding-left: 1.375rem;
    display: grid;
    gap: 0.375rem;
  }
  .bridge-links a {
    font-weight: 700;
  }
  .bridge-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.5rem;
    font-weight: 700;
    text-decoration: none;
  }
  .bridge-all svg {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 0.2s ease;
  }
  .bridge-all:hover svg {
    transform: translateX(0.25rem);
    color: var(--acc);
  }
  .bridge + .chapter {
    border-top: 0;
  }

  @media (min-width: 1100px) {
    .toc-details {
      display: none;
    }
    .layout {
      grid-template-columns: minmax(0, 1fr) 14.5rem;
      gap: 3.5rem;
    }
    .toc-side {
      display: block;
    }
  }
  @media (max-width: 899px) {
    .head {
      padding-bottom: 2rem;
    }
    .chapter {
      padding-block: 2.75rem;
    }
    .chapter:first-child {
      padding-top: 1.75rem;
    }
    /* Chapter bar: stays under the sticky rail (z-index 5) while reading. */
    .toc-details {
      position: sticky;
      top: var(--rail-h, 3.25rem);
      z-index: 4;
      margin-top: 0;
      padding-bottom: 0;
      background: var(--bg);
    }
    .toc-details summary {
      padding-block: 0.75rem;
    }
    .toc-details summary:focus-visible {
      outline: 2px solid var(--acc);
      outline-offset: -2px;
    }
    .toc-details nav {
      max-height: calc(100dvh - var(--rail-h, 3.25rem) - var(--bar-h, 3rem) - 1rem);
      overflow-y: auto;
      padding-bottom: 0.75rem;
    }
  }
</style>
