---
/** "Along the way": the smaller wins beyond the three cases — a map by area and month, then one card per win. */
import Eyebrow from "../components/Eyebrow.astro";
import Linked from "../components/Linked.astro";
import Pager from "../components/Pager.astro";
import Stat from "../components/Stat.astro";
import WinsMap from "../components/diagrams/WinsMap.astro";
import { loadCases } from "../data/cases";
import { AREAS, WINS, winPeriod, winsIn, type Role } from "../data/alongTheWay";
import { csTypo, l } from "../data/l10n";
import type { Locale } from "../i18n/locales";
import { localizedPath, subPagePath } from "../i18n/routes";
import { plural } from "../i18n/plural";
import { PLURALS, t, type UiKey } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tt = (key: UiKey) => (locale === "cs" ? csTypo(t(locale, key)) : t(locale, key));

const csFix = (s: string) => (locale === "cs" ? csTypo(s) : s);

// Cards are numbered in reading order: area by area, in time order within an area.
const ordered = AREAS.flatMap((a) => winsIn(a.id));
const numbers = new Map(ordered.map((w, i) => [w.id, i + 1]));

const ROLE: Record<Role, ReturnType<typeof l>> = {
  agent: l("agent", "agent"),
  script: l("script", "skript"),
  person: l("person", "člověk"),
};
const WHO = l("Who does what", "Kdo co dělá");
const winsHref = localizedPath(locale, "wins");
const lastCase = (await loadCases(locale)).at(-1);
---

<div class="column">
<header class="head">
  <a class="back" href={`${winsHref}#along-the-way`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M11 6l-6 6 6 6" />
    </svg>
    {tt("wins.back")}
  </a>
  <Eyebrow>{tt("atw.eyebrow")}</Eyebrow>
  <h1>{tt("atw.title")}</h1>
  <p class="lead">{tt("atw.lead")}</p>
  <p class="count" data-atw-count>
    <b>{WINS.length}</b> {csFix(plural(locale, WINS.length, PLURALS[locale]["atw.countWins"]))} · <b>{AREAS.length}</b> {csFix(plural(locale, AREAS.length, PLURALS[locale]["atw.countAreas"]))} · {tt("atw.countPeriod")}
  </p>
  <WinsMap locale={locale} numbers={numbers} />
</header>

{
  AREAS.map((a) => (
    <section class="area" id={`area-${a.id}`} data-area={a.id}>
      <h2>{a.title[locale]}</h2>
      <p class="note">{a.note[locale]}</p>
      <ol class="cards">
        {winsIn(a.id).map((w) => (
          <li class="card" id={`win-${w.id}`} data-win={w.id}>
            <p class="meta">
              <b>{numbers.get(w.id)}</b>
              <span>{winPeriod(w, locale)}</span>
            </p>
            <h3>{w.title[locale]}</h3>
            <p class="text">
              <Linked text={w.text[locale]} />
            </p>
            {w.metric && <Stat id={w.metric} locale={locale} />}
            <p class="who">
              <span class="sr">{WHO[locale]}:</span>
              {w.who.map((r) => <span class:list={["role", r]}>{ROLE[r][locale]}</span>)}
            </p>
          </li>
        ))}
      </ol>
    </section>
  ))
}

<Pager
  label={tt("atw.eyebrow")}
  prev={lastCase && { href: subPagePath(locale, "wins", lastCase.id), k: tt("wins.prev"), v: lastCase.title, rel: "prev" }}
  next={{ href: localizedPath(locale, "ai-delivery", "offer"), k: tt("wins.offerEyebrow"), v: tt("wins.offerLink") }}
/>
</div>

<style>
  .column {
    max-width: 54rem;
    margin-inline: auto;
  }
  .head {
    padding-bottom: 1rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--mute);
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .back svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .head h1 {
    font-size: var(--page-title-size);
    max-width: 20ch;
  }
  .lead {
    margin-top: 1.5rem;
    font-size: 1.125rem;
  }
  .count {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--mute);
  }
  .count b {
    color: var(--ink);
  }
  .area {
    padding-top: 3.5rem;
    scroll-margin-top: 1.5rem;
  }
  .area h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .note {
    margin-top: 0.5rem;
    color: var(--mute);
  }
  .cards {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem 1.375rem 1.125rem;
    border: 1px solid var(--line);
    border-top: 2px solid var(--acc);
    border-radius: 0 0 0.875rem 0.875rem;
    background: var(--tint);
    min-width: 0;
    scroll-margin-top: 1.5rem;
  }
  .card:target {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }
  .meta {
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
    font-size: 0.75rem;
    color: var(--mute);
  }
  .meta b {
    color: var(--acc-text);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mute);
  }
  .card :global(.stat) {
    margin-top: 0.25rem;
  }
  .who {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .role {
    font-size: 0.6875rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 1px 0.5rem;
    border: 1px solid var(--line);
    color: var(--mute);
  }
  .role.agent {
    border-color: var(--acc);
    color: var(--acc-text);
  }
  .role.person {
    border-color: var(--ink);
    color: var(--ink);
  }
  @media (max-width: 799px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
