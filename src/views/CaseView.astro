---
import { render } from "astro:content";
import Eyebrow from "../components/Eyebrow.astro";
import Pager from "../components/Pager.astro";
import Prose from "../components/Prose.astro";
import Stat from "../components/Stat.astro";
import { caseNumber, loadCases } from "../data/cases";
import type { CaseId } from "../content.config";
import { csTypo } from "../data/l10n";
import type { Locale } from "../i18n/locales";
import { localizedPath, subPagePath } from "../i18n/routes";
import { t, type UiKey } from "../i18n/ui";

interface Props {
  locale: Locale;
  id: CaseId;
}

const { locale, id } = Astro.props;
const tt = (key: UiKey) => (locale === "cs" ? csTypo(t(locale, key)) : t(locale, key));

const cases = await loadCases(locale);
const index = cases.findIndex((c) => c.id === id);
const c = cases[index];
if (!c) throw new Error(`case ${locale}/${id} is missing`);
const { Content, headings } = await render(c.entry);
const prev = cases[index - 1];
const next = cases[index + 1];
const sections = headings.filter((h) => h.depth === 2);
const winsHref = localizedPath(locale, "wins");
---

<div class="column">
<header class="head">
  <a class="back" href={`${winsHref}#cases`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M11 6l-6 6 6 6" />
    </svg>
    {tt("wins.back")}
  </a>
  <Eyebrow>
    <span data-case-number>{t(locale, "wins.case")} {caseNumber(c.order)}</span>
  </Eyebrow>
  <h1>{c.title}</h1>
  <p class="lead">{c.summary}</p>
  <div class="glance" data-case-glance>
    {c.highlights.map((m) => <Stat id={m} locale={locale} />)}
  </div>
  {
    sections.length > 0 && (
      <nav class="index" data-case-index aria-label={t(locale, "case.onThisPage")}>
        <span class="index-k" aria-hidden="true">{tt("case.onThisPage")}</span>
        <ul>
          {sections.map((h) => (
            <li><a href={`#${h.slug}`}>{locale === "cs" ? csTypo(h.text) : h.text}</a></li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<article class="case">
  <Prose>
    <Content />
  </Prose>
</article>

<Pager
  label={tt("wins.casesEyebrow")}
  prev={prev && { href: subPagePath(locale, "wins", prev.id), k: tt("wins.prev"), v: prev.title, rel: "prev" }}
  next={
    next
      ? { href: subPagePath(locale, "wins", next.id), k: tt("wins.next"), v: next.title, rel: "next" }
      : { href: subPagePath(locale, "wins", "along-the-way"), k: tt("wins.moreEyebrow"), v: tt("atw.title") }
  }
/>
</div>

<style>
  /* No side TOC here: one column, centred, as wide as the widest diagram, so text, examples, stats and
     diagrams share both edges (the same width as the Wins & cases landing). */
  .column {
    max-width: 54rem;
    margin-inline: auto;
  }
  .head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--mute);
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .back svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .head h1 {
    font-size: var(--page-title-size);
    max-width: 20ch;
  }
  .lead {
    margin-top: 1.5rem;
    font-size: 1.125rem;
  }
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    gap: 1.5rem 1.75rem;
    margin-top: 2.25rem;
  }
  .index {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 1.75rem;
    font-size: 0.9375rem;
  }
  .index-k {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--mute);
  }
  .index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index li {
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .index a {
    color: var(--acc-text);
    overflow-wrap: anywhere;
  }
  .case {
    padding-block: 1rem 4rem;
  }
  /* A little air above a section heading reached from the index (the mobile rail is reserved globally). */
  .case :global(h2[id]) {
    scroll-margin-top: 1rem;
  }

</style>
