---
import { render } from "astro:content";
import Eyebrow from "../components/Eyebrow.astro";
import Prose from "../components/Prose.astro";
import Stat from "../components/Stat.astro";
import { caseNumber, loadCases } from "../data/cases";
import type { CaseId } from "../content.config";
import { csTypo } from "../data/l10n";
import type { Locale } from "../i18n/locales";
import { localizedPath, subPagePath } from "../i18n/routes";
import { t, type UiKey } from "../i18n/ui";

interface Props {
  locale: Locale;
  id: CaseId;
}

const { locale, id } = Astro.props;
const tt = (key: UiKey) => (locale === "cs" ? csTypo(t(locale, key)) : t(locale, key));

const cases = await loadCases(locale);
const index = cases.findIndex((c) => c.id === id);
const c = cases[index];
if (!c) throw new Error(`case ${locale}/${id} is missing`);
const { Content } = await render(c.entry);
const prev = cases[index - 1];
const next = cases[index + 1];
const winsHref = localizedPath(locale, "wins");
---

<div class="column">
<header class="head">
  <a class="back" href={`${winsHref}#cases`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M11 6l-6 6 6 6" />
    </svg>
    {tt("wins.back")}
  </a>
  <Eyebrow>
    <span data-case-number>{t(locale, "wins.case")} {caseNumber(c.order)}</span>
  </Eyebrow>
  <h1>{c.title}</h1>
  <p class="lead">{c.summary}</p>
  <div class="glance" data-case-glance>
    {c.highlights.map((m) => <Stat id={m} locale={locale} detail={false} />)}
  </div>
</header>

<article class="case">
  <Prose>
    <Content />
  </Prose>
</article>

<nav class="pager" aria-label={tt("wins.casesEyebrow")}>
  {
    prev ? (
      <a class="prev" href={subPagePath(locale, "wins", prev.id)} rel="prev">
        <span class="k">{tt("wins.prev")}</span>
        <span class="v">{prev.title}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a class="next" href={subPagePath(locale, "wins", next.id)} rel="next">
        <span class="k">{tt("wins.next")}</span>
        <span class="v">{next.title}</span>
      </a>
    ) : (
      <a class="next" href={localizedPath(locale, "ai-delivery", "offer")}>
        <span class="k">{tt("ai.bridgeEyebrow")}</span>
        <span class="v">{tt("wins.offerLink")}</span>
      </a>
    )
  }
</nav>
</div>

<style>
  /* No side TOC here: one reading column, as wide as the text measure, centred in the page. */
  .column {
    max-width: 46rem;
    margin-inline: auto;
  }
  .head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 1.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--mute);
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .back svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .head h1 {
    font-size: clamp(2.75rem, 5.6vw, 5rem);
    max-width: 16ch;
  }
  .lead {
    margin-top: 1.5rem;
    max-width: 64ch;
    font-size: 1.125rem;
  }
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.75rem, 1fr));
    gap: 1.5rem 1.75rem;
    margin-top: 2.25rem;
    max-width: 47.5rem;
  }
  .case {
    padding-block: 1rem 4rem;
  }
  /* Diagrams and stat rows need more room than a line of text: on wide screens they step out of the
     text column, symmetrically, to the width the long-read pages give them. */
  @media (min-width: 1100px) {
    .case :global(.body > :is(.scroll, .stats, [data-diagram])) {
      width: 54rem;
      max-width: none;
      margin-inline: -4rem;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 2.5rem 1rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.375rem;
    padding: 1.25rem 1.375rem;
    background: var(--tint);
    border-radius: 0.875rem;
    text-decoration: none;
  }
  .pager a:hover {
    outline: 2px solid var(--acc);
    outline-offset: -2px;
  }
  .pager .next {
    text-align: right;
  }
  .pager .k {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
  }
  .pager .v {
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
    font-size: 1.375rem;
    line-height: 1.05;
  }
  @media (max-width: 699px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
