---
import { Image } from "astro:assets";
import photo from "../assets/photo.jpg";
import Eyebrow from "../components/Eyebrow.astro";
import { CV } from "../data/cv";
import { formatRange } from "../i18n/dates";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const name = t(locale, "site.name");
const linkedinLabel = CV.contact.linkedin.replace(/^https?:\/\/(www\.)?/, "");
---

<article class="cv">
  <header class="head">
    <Eyebrow>{t(locale, "cv.eyebrow")}</Eyebrow>
    <h1>{name}</h1>
    <p class="headline">{CV.headline[locale]}</p>
  </header>

  <div class="about">
    <figure class="photo">
      <Image src={photo} alt={t(locale, "cv.photoAlt")} width={600} widths={[300, 600]} sizes="(max-width: 899px) 280px, 300px" loading="eager" />
    </figure>

    <div class="body">
      <section class="profile" aria-labelledby="cv-profile">
        <h2 id="cv-profile" class="label">{t(locale, "cv.profile")}</h2>
        <p class="bio">{CV.profile[locale]}</p>
      </section>

      <section class="xp" aria-labelledby="cv-experience">
        <h2 id="cv-experience" class="label">{t(locale, "cv.experience")}</h2>
        {
          CV.roles.map((role) => (
            <div class:list={["xrow", { now: role.to === null }]} data-role data-current={role.to === null ? "" : undefined}>
              <span class="d">{formatRange(locale, role.from, role.to)}</span>
              <div>
                <p class="who">
                  <b data-role-title>{role.title[locale]}</b>
                  <span class="c">
                    {" · "}
                    {role.company}
                    {role.client && ` · ${role.client}`}
                  </span>
                </p>
                <p class="sum">{role.summary[locale]}</p>
              </div>
            </div>
          ))
        }
      </section>

      <section class="skillset" aria-labelledby="cv-skills">
        <h2 id="cv-skills" class="label">{t(locale, "cv.skills")}</h2>
        {
          CV.skills.map((group) => (
            <div class="skills">
              <span class="k">{group.group[locale]}</span>
              {group.items.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          ))
        }
      </section>

      <div class="foot">
        <section aria-labelledby="cv-languages">
          <h2 id="cv-languages" class="label">{t(locale, "cv.languages")}</h2>
          <ul class="plain">
            {CV.languages.map((lang) => <li>{lang[locale]}</li>)}
          </ul>
        </section>
        <section aria-labelledby="cv-contact">
          <h2 id="cv-contact" class="label">{t(locale, "cv.contact")}</h2>
          <ul class="plain">
            <li>
              <a href={`mailto:${CV.contact.email}`}>{CV.contact.email}</a>
            </li>
            <li>
              <a href={CV.contact.linkedin} rel="noopener" target="_blank">{linkedinLabel}</a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</article>

<style>
  .head {
    margin-bottom: 44px;
  }
  .headline {
    margin-top: 16px;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 600;
    color: var(--mute);
    letter-spacing: -0.01em;
  }
  .about {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .photo {
    margin: 0;
    position: sticky;
    top: 32px;
    aspect-ratio: 2 / 3;
    border-radius: 16px;
    overflow: hidden;
    background: var(--tint);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    min-width: 0;
  }
  .label {
    font-size: 13px;
    font-weight: 600;
    color: var(--mute);
    text-transform: none;
    letter-spacing: 0;
    font-variation-settings: "wdth" 100;
    line-height: 1.4;
    margin: 0 0 10px;
  }
  .bio {
    font-size: 17px;
    max-width: 62ch;
  }
  .xp {
    margin-top: 36px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .xrow {
    display: grid;
    grid-template-columns: 172px minmax(0, 1fr);
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .xrow .d {
    color: var(--mute);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    padding-top: 2px;
  }
  .xrow .who {
    line-height: 1.4;
  }
  .xrow b {
    font-weight: 700;
  }
  .xrow .c {
    color: var(--mute);
  }
  .xrow .sum {
    margin-top: 4px;
    color: var(--mute);
    font-size: 14px;
    max-width: 64ch;
  }
  .xrow.now {
    border-left: 3px solid var(--acc);
    padding-left: 12px;
    margin-left: -15px;
  }
  .skillset {
    margin-top: 36px;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }
  .skills span {
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
    line-height: 1.3;
  }
  .skills span.k {
    border: 0;
    background: var(--tint);
    color: var(--mute);
  }
  .foot {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
  }
  .plain li + li {
    margin-top: 4px;
  }
  .plain a {
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .plain a:hover {
    text-decoration-color: var(--acc);
  }

  @media (max-width: 899px) {
    .head {
      margin-bottom: 28px;
    }
    .about {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .photo {
      position: static;
      max-width: 280px;
    }
    .xrow {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .xrow.now {
      margin-left: 0;
    }
    .foot {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- print / PDF (A4, light, ≤ 2 pages) ---------- */
  @media print {
    .cv {
      position: relative;
      font-size: 10pt;
      line-height: 1.4;
    }
    /* The photo sits beside the name: a 2:3 portrait column would eat half of page 1. */
    .head {
      padding-right: 34mm;
      min-height: 36mm;
      margin-bottom: 5mm;
    }
    .head :global(.eyebrow) {
      margin-bottom: 3mm;
      font-size: 9pt;
    }
    .head h1 {
      font-size: 30pt;
    }
    .headline {
      margin-top: 2.5mm;
      font-size: 13pt;
    }
    .about {
      display: block;
    }
    .photo {
      position: absolute;
      right: 0;
      top: 0;
      width: 24mm;
      border-radius: 3mm;
    }
    .label {
      font-size: 8.5pt;
      margin-bottom: 2mm;
    }
    .bio {
      font-size: 10pt;
      max-width: none;
    }
    .xp {
      margin-top: 6mm;
      padding-top: 3mm;
    }
    .xrow {
      grid-template-columns: 40mm minmax(0, 1fr);
      gap: 4mm;
      padding: 2.4mm 0;
      font-size: 10pt;
      break-inside: avoid;
    }
    .xrow .d {
      font-size: 9pt;
      padding-top: 0.5mm;
    }
    .xrow .sum {
      font-size: 9pt;
      margin-top: 1mm;
      max-width: none;
    }
    .xrow.now {
      padding-left: 3mm;
      margin-left: -4mm;
    }
    .skillset {
      margin-top: 5mm;
      break-inside: avoid;
    }
    .skills {
      gap: 1.2mm;
      margin-bottom: 1.5mm;
    }
    .skills span {
      font-size: 8.5pt;
      padding: 0.8mm 2.4mm;
    }
    .foot {
      margin-top: 5mm;
      padding-top: 3.5mm;
      gap: 8mm;
      break-inside: avoid;
    }
    .plain {
      font-size: 9.5pt;
    }
    .plain a {
      text-decoration: none;
      color: var(--ink);
    }
  }
</style>
