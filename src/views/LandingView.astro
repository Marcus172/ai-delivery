---
import { Image } from "astro:assets";
import photo from "../assets/photo.jpg";
import CtaRow from "../components/CtaRow.astro";
import Orbit from "../components/diagrams/Orbit.astro";
import FactsLine from "../components/FactsLine.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Note from "../components/Note.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import { LANDING } from "../data/landing";
import { AS_OF, LANDING_METRIC_IDS, metric } from "../data/metrics";
import { OFFER } from "../data/offer";
import type { Locale } from "../i18n/locales";
import { localizedPath } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const name = t(locale, "site.name");
const stats = LANDING_METRIC_IDS.map((id) => metric(id));
const estimate = metric("five-to-ten-x");
const resultsHref = localizedPath(locale, "wins", "results");
// Each sentence of the claim stays on its own line when the two do not fit side by side.
const claimSentences = LANDING.headline[locale].split(/(?<=\.)\s+/);

const OFFER_ICONS: Record<string, string> = {
  assessment: '<circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21M8 11h6M11 8v6"/>',
  "delivery-flow": '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="12" r="2.5"/><path d="M7.5 12h9M12 9.5V5M12 14.5V19"/>',
  enablement: '<circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 19a5.5 5.5 0 0 1 11 0M13 18a4 4 0 0 1 8 0"/>',
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-text">
    <div class="who" data-hero-name>
      <Image class="avatar" src={photo} alt="" width={240} widths={[120, 240]} sizes="(max-width: 559px) 5.5rem, 7.5rem" loading="eager" />
      <div>
        <h1 id="hero-title">{name}</h1>
        <p class="role"><i aria-hidden="true"></i>{LANDING.who[locale]}</p>
      </div>
    </div>
    <FactsLine locale={locale} />
    <p class="claim" data-hero-claim>
      {claimSentences.map((sentence, i) => <>{i > 0 && " "}<span>{sentence}</span></>)}
    </p>
    <p class="lead">{LANDING.lead[locale]}</p>
    <CtaRow locale={locale} />
    <div class="stats" data-stats>
      {
        stats.map((m) => (
          <div data-metric={m.id}>
            <Stat locale={locale} value={m.value[locale]} label={m.label[locale]} kind={m.kind} />
          </div>
        ))
      }
    </div>
    <p class="period" data-stats-period>
      {AS_OF[locale].charAt(0).toUpperCase() + AS_OF[locale].slice(1)}. {LANDING.statsPeriodBefore[locale]}<a href={resultsHref}>{LANDING.statsPeriodLink[locale]}</a>.
    </p>
  </div>
  <div class="hero-art">
    <Orbit locale={locale} />
  </div>
</section>

<Section id="offer">
  <Eyebrow>{LANDING.offerEyebrow[locale]}</Eyebrow>
  <div class="split">
    <h2>{LANDING.offerTitle[locale]}</h2>
    <p class="intro">{LANDING.offerIntro[locale]}</p>
  </div>
  <div class="pillars">
    {
      OFFER.map((card) => (
        <article class="pillar" data-offer-card={card.id}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={OFFER_ICONS[card.id]}
          />
          <h3>{card.title[locale]}</h3>
          <p>{card.body[locale]}</p>
        </article>
      ))
    }
  </div>
</Section>

<Section id="about">
  <Eyebrow>{LANDING.aboutEyebrow[locale]}</Eyebrow>
  <div class="about" data-about>
    <figure class="photo">
      <Image src={photo} alt={LANDING.photoAlt[locale]} width={600} widths={[300, 600]} sizes="(max-width: 899px) 280px, 300px" loading="eager" />
      <figcaption class="badge"><i aria-hidden="true"></i>{LANDING.badge[locale]}</figcaption>
    </figure>
    <div class="about-text">
      <h2>{LANDING.aboutTitle[locale]}</h2>
      <p class="bio">{LANDING.aboutBio[locale]}</p>
      <p class="bio mute">{LANDING.aboutBio2[locale]}</p>
      <div class="estimate" data-metric={estimate.id}>
        <Stat locale={locale} value={estimate.value[locale]} label={estimate.label[locale]} kind={estimate.kind} />
        <Note as="p">
          <strong>{estimate.period[locale]}.</strong> {estimate.caveat?.[locale]}
        </Note>
      </div>
    </div>
  </div>
</Section>

<Section id="read-on">
  <Eyebrow as="h2">{LANDING.readEyebrow[locale]}</Eyebrow>
  <ul class="teasers">
    {
      LANDING.teasers.map((tz) => (
        <li>
          <a class="teaser" href={localizedPath(locale, tz.page)}>
            <span class="teaser-title">{tz.title[locale]}</span>
            <span class="teaser-body">{tz.body[locale]}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: 0 4.5rem;
  }
  .who {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin: 0 0 1rem;
  }
  .hero-text :global(.facts) {
    margin: 0 0 2rem;
  }
  .who .avatar {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--acc);
  }
  .who > div {
    display: grid;
    gap: 0.625rem;
  }
  .who h1 {
    font-size: clamp(3rem, 6vw, 5rem);
  }
  .who .role {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--mute);
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .role i,
  .badge i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--acc);
    display: inline-block;
    flex: none;
  }
  .hero .claim {
    font-size: clamp(1.625rem, 2.8vw, 2.375rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .claim span {
    display: inline-block;
  }
  .hero .lead {
    margin: 1.5rem 0 1.75rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.625rem, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .period {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--mute);
  }
  .period a {
    text-decoration-color: var(--line);
    text-underline-offset: 0.1875rem;
  }
  .period a:hover {
    text-decoration-color: var(--acc);
  }
  .hero-art {
    min-width: 0;
  }

  /* ---------- offer ---------- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 2rem;
    align-items: start;
  }
  .intro {
    color: var(--mute);
    font-size: 1.0625rem;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
  }
  .pillar {
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    padding: 1.625rem 1.5rem 1.375rem;
  }
  .pillar svg {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--acc);
  }
  .pillar h3 {
    margin: 1.125rem 0 0.5rem;
  }
  .pillar p {
    color: var(--mute);
  }

  /* ---------- about ---------- */
  .about {
    display: grid;
    grid-template-columns: 18.75rem minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }
  .photo {
    margin: 0;
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 1rem;
    background: var(--tint);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
  }
  .badge {
    position: absolute;
    left: -0.875rem;
    bottom: 1.375rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .about-text {
    min-width: 0;
  }
  .bio {
    font-size: 1.0625rem;
    margin: 1.125rem 0 0;
  }
  .bio.mute {
    font-size: 1rem;
  }
  .estimate {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  /* ---------- teasers ---------- */
  .teasers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .teaser {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.625rem;
    height: 100%;
    padding: 1.5rem 1.375rem 1.25rem;
    border-top: 2px solid var(--ink);
    text-decoration: none;
    background: var(--tint);
    border-radius: 0 0 0.875rem 0.875rem;
  }
  .teaser-title {
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .teaser-body {
    color: var(--mute);
    font-size: 0.9375rem;
  }
  .teaser svg {
    width: 1.25rem;
    height: 1.25rem;
    justify-self: end;
    transition: transform 0.2s ease;
  }
  .teaser:hover {
    border-top-color: var(--acc);
  }
  .teaser:hover svg {
    transform: translateX(0.25rem);
    color: var(--acc);
  }

  @media (max-width: 1299px) {
    .teasers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 899px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 3rem;
    }
    .split,
    .pillars,
    .about,
    .teasers {
      grid-template-columns: 1fr;
    }
    .split {
      gap: 0.875rem;
    }
    .photo {
      max-width: 17.5rem;
    }
  }
  @media (max-width: 559px) {
    .who {
      gap: 1rem;
    }
    .who .avatar {
      width: 5.5rem;
      height: 5.5rem;
    }
    .stats {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 2rem;
    }
  }
</style>
