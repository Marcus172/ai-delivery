---
import { getEntry, render } from "astro:content";
import Eyebrow from "../components/Eyebrow.astro";
import Prose from "../components/Prose.astro";
import Section from "../components/Section.astro";
import Stat from "../components/Stat.astro";
import { caseNumber, loadCases } from "../data/cases";
import { AREAS, WINS } from "../data/alongTheWay";
import { csTypo } from "../data/l10n";
import type { Locale } from "../i18n/locales";
import { localizedPath, subPagePath } from "../i18n/routes";
import { t, type UiKey } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const typo = (s: string) => (locale === "cs" ? csTypo(s) : s);
const tt = (key: UiKey) => typo(t(locale, key));

const resultsEntry = await getEntry("results", locale);
if (!resultsEntry) throw new Error(`results/${locale}.mdx is missing`);
const { Content: Results } = await render(resultsEntry);
const cases = await loadCases(locale);
---

<div class="column">
<header class="head">
  <Eyebrow>{tt("wins.eyebrow")}</Eyebrow>
  <h1>{tt("wins.title")}</h1>
  <p class="lead">{tt("wins.lead")}</p>
  <p class="as-of">{t(locale, "ai.asOf")}</p>
</header>

<Section id="results" class="results">
  <Eyebrow>{tt("wins.resultsEyebrow")}</Eyebrow>
  <h2>{typo(resultsEntry.data.title)}</h2>
  <p class="summary">{typo(resultsEntry.data.summary)}</p>
  <Prose>
    <Results />
  </Prose>
</Section>

<Section id="cases">
  <Eyebrow>{tt("wins.casesEyebrow")}</Eyebrow>
  <h2>{tt("wins.casesTitle")}</h2>
  <p class="summary">{tt("wins.casesIntro")}</p>
  <ol class="cards" data-case-cards>
    {
      cases.map((c) => (
        <li class="card" data-case={c.id}>
          <p class="card-n">
            {t(locale, "wins.case")} {caseNumber(c.order)}
          </p>
          <h3>
            <a href={subPagePath(locale, "wins", c.id)}>{c.title}</a>
          </h3>
          <p class="card-summary">{c.teaser}</p>
          <div class="card-stats">
            {c.highlights.map((id) => <Stat id={id} locale={locale} detail={false} />)}
          </div>
          <span class="card-more" aria-hidden="true">
            {t(locale, "wins.readCase")}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </li>
      ))
    }
  </ol>
  <div class="more" id="along-the-way" data-more-wins>
    <div class="more-text">
      <p class="card-n">{tt("wins.moreEyebrow")}</p>
      <h3>
        <a href={subPagePath(locale, "wins", "along-the-way")}>{WINS.length} {tt("wins.moreTitle")}</a>
      </h3>
      <p class="card-summary">{tt("wins.moreText")}</p>
    </div>
    <div class="more-side">
      <ul class="more-areas" aria-hidden="true">
        {AREAS.map((a) => <li>{a.title[locale]}</li>)}
      </ul>
      <span class="card-more" aria-hidden="true">
        {t(locale, "wins.moreLink")}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    </div>
  </div>
</Section>

<Section id="next">
  <ul class="next">
    <li>
      <p class="next-k">{tt("wins.howEyebrow")}</p>
      <p>{tt("wins.howText")}</p>
      <a href={localizedPath(locale, "ai-delivery")}>{tt("wins.howLink")}</a>
    </li>
    <li>
      <p class="next-k">{tt("wins.offerEyebrow")}</p>
      <p>{tt("wins.offerText")}</p>
      <a href={localizedPath(locale, "ai-delivery", "offer")}>{tt("wins.offerLink")}</a>
    </li>
  </ul>
</Section>
</div>

<style>
  /* No side TOC here: the reading column is centred in the page instead of hugging the left edge. */
  .column {
    max-width: 54rem;
    margin-inline: auto;
  }
  .head {
    padding-bottom: 3rem;
  }
  .head h1 {
    font-size: var(--page-title-size);
    max-width: 20ch;
  }
  .head .lead {
    margin-top: 1.5rem;
  }
  .as-of {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--mute);
  }
  h2 {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    max-width: 18ch;
  }
  .summary {
    margin-top: 1.125rem;
    font-size: 1.125rem;
    color: var(--mute);
  }
  :global(#results),
  :global(#cases) {
    scroll-margin-top: 0.75rem;
  }

  /* ---------- case cards: one row per case, the story on the left, its figures on the right ---------- */
  .cards {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16.5rem);
    grid-template-areas:
      "n stats"
      "title stats"
      "summary stats"
      "more stats";
    grid-template-rows: auto auto 1fr auto;
    gap: 0.75rem 2.5rem;
    padding: 1.625rem 1.75rem 1.5rem;
    border-top: 2px solid var(--ink);
    background: var(--tint);
    border-radius: 0 0 0.875rem 0.875rem;
  }
  .card:hover,
  .card:focus-within {
    border-top-color: var(--acc);
  }
  .card-n {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
  }
  .card h3 {
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .card h3 a {
    text-decoration: none;
  }
  /* The title link stretches over the whole card: one link, named by the title, clickable anywhere. */
  .card h3 a::after {
    content: "";
    position: absolute;
    inset: -2px 0 0;
    border-radius: 0 0 0.875rem 0.875rem;
  }
  .card h3 a:focus-visible {
    outline: none;
  }
  .card h3 a:focus-visible::after {
    outline: 2px solid var(--acc);
    outline-offset: 0.1875rem;
  }
  .card h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .card .card-n {
    grid-area: n;
  }
  .card h3 {
    grid-area: title;
  }
  .card .card-summary {
    grid-area: summary;
  }
  .card-summary {
    color: var(--mute);
    font-size: 0.9375rem;
  }
  .card-stats {
    grid-area: stats;
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .card-stats :global(.stat) {
    margin-top: 0;
  }
  .card .card-more {
    grid-area: more;
  }
  .card-more {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .card-more svg {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 0.2s ease;
  }
  .card:hover .card-more svg {
    transform: translateX(0.25rem);
    color: var(--acc);
  }

  /* ---------- along the way: not a case, so its own outlined row under the cases ---------- */
  .more {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16.5rem);
    gap: 0.75rem 2.5rem;
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    border: 1px dashed var(--line);
    border-radius: 0.875rem;
  }
  .more:hover,
  .more:focus-within {
    border-color: var(--acc);
  }
  .more-text {
    display: grid;
    gap: 0.75rem;
  }
  .more h3 {
    font-weight: 800;
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .more h3 a {
    text-decoration: none;
  }
  .more h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0.875rem;
  }
  .more h3 a:focus-visible {
    outline: none;
  }
  .more h3 a:focus-visible::after {
    outline: 2px solid var(--acc);
    outline-offset: 0.1875rem;
  }
  .more h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .more-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }
  .more-areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .more-areas li {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--mute);
  }
  .more:hover .card-more svg {
    transform: translateX(0.25rem);
    color: var(--acc);
  }
  @media (max-width: 699px) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "n" "title" "summary" "stats" "more";
      grid-template-rows: none;
    }
    .card,
    .more {
      padding-inline: 1.375rem;
    }
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- next ---------- */
  .next {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
  }
  .next li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .next-k {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--acc-text);
  }
  .next a {
    font-weight: 700;
  }

  @media (max-width: 699px) {
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
